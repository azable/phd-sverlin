{
  "files.associations": {
    "*.css": "tailwindcss",
    "*.hs": "haskell",
    "*.sverlin": "haskell",
    "*.lhs": "haskell",
    "*.hs-boot": "haskell",
    "*.hsc": "haskell",
    "*.cabal": "cabal",
    "cabal.project": "plaintext"
  },

  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "[svelte]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[haskell]": {
    "editor.formatOnSave": false
  },
  "[cabal]": {
    "editor.formatOnSave": false
  },

  "haskell.manageHLS": "PATH",
  "haskell.formattingProvider": "none",

  "editor.tabSize": 2
}
