data Value
instance Traceable Value where
  type Payload Value = LInt Value

data OriginalRole
data ForkRole
data SelectedRole
data ContinuedRole
data Original
data Forked
data SelectedBranch
data SelectionCleared
data Complete

originalKind :: Kind Value
originalKind = kind @OriginalRole

forkKind :: Kind Value
forkKind = kind @ForkRole

selectedKind :: Kind Value
selectedKind = kind @SelectedRole

continuedKind :: Kind Value
continuedKind = kind @ContinuedRole

data Initial where
  Initial :: Block Value %1 -> Initial

data Pair where
  Pair :: Block Value %1 -> Block Value %1 -> Pair

domain :: Domain Initial
domain = do
  declareKind originalKind
  declareKind forkKind
  declareKind selectedKind
  declareKind continuedKind
  declareSteps @'[Original, Forked, SelectedBranch, SelectionCleared, Complete]
  Create pending <- create (LInt 7)
  value <- materialize originalKind pending
  pure (Initial value)

program :: Initial %1 -> Program ()
program (Initial original) = do
  original1 <- step @Original (pure original)

  Copy original2 forkPending <- copy original1
  forked <- materialize forkKind forkPending
  Pair original3 forked1 <- step @Forked (pure (Pair original2 forked))

  Copy original4 selectedPending <- copy original3
  Replace selectedPending1 <- replace original4 selectedPending
  selected <- materialize selectedKind selectedPending1
  Pair selected1 forked2 <- step @SelectedBranch (pure (Pair selected forked1))

  Copy selected2 continuedPending <- copy selected1
  Replace continuedPending1 <- replace selected2 continuedPending
  continued <- materialize continuedKind continuedPending1
  Pair continued1 forked3 <-
    step @SelectionCleared (pure (Pair continued forked2))

  step @Complete $ do
    Destroy <- destroy forked3
    Destroy <- destroy continued1
    pure ()

valueNode :: ContentValue -> Render ()
valueNode label = do
  content label
  width (by 180)
  height (by 112)

render :: Render ()
render = do
  always $ frame @Original
  always $ frame @Forked
  always $ frame @SelectedBranch
  always $ frame @SelectionCleared
  always $ frame @Complete
  width (by 800)
  height (by 450)
  contentFit Both Contain

  originals <- select originalKind
  forks <- select forkKind
  selectedValues <- select selectedKind
  continuedValues <- select continuedKind

  node originals $ do
    label <- bindContent
    valueNode label
    x (at 260)
    y (at 200)

  node forks $ do
    label <- bindContent
    valueNode label
    x (at 540)
    y (at 200)

  node selectedValues $ do
    label <- bindContent
    valueNode label
    x (at 260)
    y (at 200)
    style @StrokeWidth (by 6)
    style @Stroke (Hsl (num 216) (num 0.72) (num 0.42))
    style @BorderStyle BorderSolid

  node continuedValues $ do
    label <- bindContent
    valueNode label
    x (at 260)
    y (at 200)
