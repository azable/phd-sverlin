data Value
instance Traceable Value where
  type Payload Value = LInt Value

data Match
instance Traceable Match where
  type Payload Match = LBool Match

data Equal
instance Traceable Equal where
  type Payload Equal = LOperator Equal

instance Applicable2 Equal Value Value where
  type Apply2Result Equal Value Value = Match
  applyPayload2 LOperator (LInt leftValue) (LInt rightValue) =
    LBool (leftValue Linear.== rightValue)

data TargetRole
data ElementRole
data TargetProbeRole
data ElementProbeRole
data EqualRole
data MatchRole
data Initialize
data PrepareComparison
data Compare
data Found
data Continue
data Exhausted
data Complete

targetKind :: Kind Value
targetKind = kind @TargetRole

elementKind :: Kind Value
elementKind = kind @ElementRole

targetProbeKind :: Kind Value
targetProbeKind = kind @TargetProbeRole

elementProbeKind :: Kind Value
elementProbeKind = kind @ElementProbeRole

equalKind :: Kind Equal
equalKind = kind @EqualRole

matchKind :: Kind Match
matchKind = kind @MatchRole

data Elements where
  NoElements :: Elements
  MoreElement :: Block Value %1 -> Elements %1 -> Elements

data Initial where
  Initial :: Block Value %1 -> Elements %1 -> Initial

data Prepared where
  Prepared ::
    Block Value %1 ->
    Block Value %1 ->
    Elements %1 ->
    Block Equal %1 ->
    Block Value %1 ->
    Block Value %1 ->
    Prepared

data Compared where
  Compared :: Block Value %1 -> Block Value %1 -> Elements %1 -> Block Match %1 -> Compared

domain :: Domain Initial
domain = do
  declareKind targetKind
  declareKind elementKind
  declareKind targetProbeKind
  declareKind elementProbeKind
  declareKind equalKind
  declareKind matchKind
  declareSteps @'[Initialize, PrepareComparison, Compare, Found, Continue, Exhausted, Complete]
  Create targetPending <- create (LInt 7)
  target <- materialize targetKind targetPending
  first <- createElement 4
  second <- createElement 9
  third <- createElement 2
  fourth <- createElement 7
  pure (Initial target (MoreElement first (MoreElement second (MoreElement third (MoreElement fourth NoElements)))))

createElement :: Int %1 -> Domain (Block Value)
createElement value = do
  Create pending <- create (LInt value)
  materialize elementKind pending

program :: Initial %1 -> Program ()
program initial = do
  Initial target elements <- step @Initialize (pure initial)
  searchIteration target elements
  step @Complete (pure ())

searchIteration :: Block Value %1 -> Elements %1 -> Program ()
searchIteration target elements =
  case elements of
    NoElements ->
      step @Exhausted $ do
        Destroy <- destroy target
        pure ()
    MoreElement element remaining -> do
      prepared <- step @PrepareComparison (prepareComparison target element remaining)
      Compared target1 element1 remaining1 result <- step @Compare (comparePrepared prepared)
      Use (LBool matches) <- use result
      case matches of
        True ->
          step @Found $ do
            Destroy <- destroy target1
            Destroy <- destroy element1
            destroyElements remaining1
        False ->
          step @Continue $ do
            Destroy <- destroy element1
            searchIteration target1 remaining1

prepareComparison :: Block Value %1 -> Block Value %1 -> Elements %1 -> Program Prepared
prepareComparison target element remaining = do
  Copy target1 targetProbePending <- copy target
  targetProbe <- materialize targetProbeKind targetProbePending
  Copy element1 elementProbePending <- copy element
  elementProbe <- materialize elementProbeKind elementProbePending
  Create equalPending <- create LOperator
  equalOperator <- materialize equalKind equalPending
  pure (Prepared target1 element1 remaining equalOperator targetProbe elementProbe)

comparePrepared :: Prepared %1 -> Program Compared
comparePrepared (Prepared target element remaining equalOperator targetProbe elementProbe) = do
  Apply2 resultPending <- apply2 equalOperator targetProbe elementProbe
  result <- materialize matchKind resultPending
  pure (Compared target element remaining result)

destroyElements :: Elements %1 -> Program ()
destroyElements elements =
  case elements of
    NoElements -> pure ()
    MoreElement element remaining -> do
      Destroy <- destroy element
      destroyElements remaining

comparisonLine :: ContentValue
comparisonLine = do
  literal "compare "
  fragment @PrepareComparison "target"
  literal " with "
  fragment @PrepareComparison "A[i]"
  fragmentMany @'[Compare, Found] "; stop when equal"

render :: Render ()
render = do
  always $ frame @Initialize
  sometimes $ frame @PrepareComparison
  always $ frame @Compare
  sometimes $ frame @Continue
  always $ frame @Found
  always $ frame @Complete
  width (by 920)
  height (by 560)
  contentFit Both Contain

  bodyFont <- fontChoice (fontKind Proportional)
  codeFont <- fontChoice (fontKind Monospace)
  targets <- select targetKind
  elements <- select elementKind
  targetProbes <- select targetProbeKind
  elementProbes <- select elementProbeKind
  equalOperators <- select equalKind
  matches <- select matchKind

  node targets $ do
    label <- bindContent
    fitText label
    width (by 112)
    height (by 80)
    x (at 112)
    y (at 120)
    style @FontFamily bodyFont

  node elements $ do
    label <- bindContent
    fitText label
    width (by 88)
    height (by 72)
    style @FontFamily bodyFont
  arrange (ArrangeGrid 4 (vec2 (by 18) (by 18))) elements

  comparison <- node $ do
    width (by 580)
    height (by 124)
    x (at 560)
    y (at 310)
    contentFit Both Contain

    node targetProbes $ do
      label <- bindContent
      fitText label
      width (by 104)
      height (by 72)
      xAt (percent 12)
      yAt (percent 50)
      style @FontFamily bodyFont

    node equalOperators $ do
      fitText (text "==")
      width (by 64)
      height (by 64)
      xAt (percent 38)
      yAt (percent 50)
      style @FontFamily codeFont
      withoutStyle @Fill

    node elementProbes $ do
      label <- bindContent
      fitText label
      width (by 104)
      height (by 72)
      xAt (percent 62)
      yAt (percent 50)
      style @FontFamily bodyFont

    node matches $ do
      label <- bindContent
      fitText label
      width (by 112)
      height (by 76)
      xAt (percent 88)
      yAt (percent 50)
      style @FontFamily bodyFont

    sometimes $ connector (anchor AtBoundary targetProbes) (anchor AtBoundary elementProbes) $ do
      endMarker ArrowMarker
      style @StrokeWidth (by 2)

  codeLine <- node $ do
    content comparisonLine
    width (by 560)
    height (by 72)
    x (at 460)
    y (at 490)
    style @FontFamily codeFont
    style @TextAlign TextAlignLeft

  ensure $ separatedBy (by 28) targets comparison
  ensure $ bottom codeLine .<=. bottom canvas
