data Item
instance Traceable Item where
  type Payload Item = LString Item

data ParseRole
data SolveRole
data RenderRole
data Pipeline
data Complete

parseKind :: Kind Item
parseKind = kind @ParseRole

solveKind :: Kind Item
solveKind = kind @SolveRole

renderKind :: Kind Item
renderKind = kind @RenderRole

data Initial where
  Initial :: Block Item %1 -> Block Item %1 -> Block Item %1 -> Initial

domain :: Domain Initial
domain = do
  declareKind parseKind
  declareKind solveKind
  declareKind renderKind
  declareSteps @'[Pipeline, Complete]
  Create parsePending <- create (LString "Parse")
  parse <- materialize parseKind parsePending
  Create solvePending <- create (LString "Solve")
  solve <- materialize solveKind solvePending
  Create renderPending <- create (LString "Render")
  output <- materialize renderKind renderPending
  pure (Initial parse solve output)

program :: Initial %1 -> Program ()
program initial = do
  Initial parse solve output <- step @Pipeline (pure initial)
  step @Complete $ do
    Destroy <- destroy parse
    Destroy <- destroy solve
    Destroy <- destroy output
    pure ()

render :: Render ()
render = do
  always $ frame @Pipeline
  always $ frame @Complete
  width (by 800)
  height (by 600)
  contentFit Both Contain

  parseItems <- select parseKind
  solveItems <- select solveKind
  renderItems <- select renderKind

  node parseItems $ do
    label <- bindContent
    content label
    width (by 144)
    height (by 88)

  node solveItems $ do
    label <- bindContent
    content label
    width (by 144)
    height (by 88)

  node renderItems $ do
    label <- bindContent
    content label
    width (by 144)
    height (by 88)

  gap <- variable @Span
  ensure $ gap .>=. by 24
  ensure $ gap .<=. by 72

  oneOf "pipeline.composition"
    (alternative "row" $ do
      ensure $ left solveItems .==. (right parseItems .+. gap)
      ensure $ left renderItems .==. (right solveItems .+. gap)
      ensure $ y parseItems .==. y solveItems
      ensure $ y solveItems .==. y renderItems
      ensure $ x solveItems .==. x canvas
      ensure $ y solveItems .>=. at 180
      ensure $ y solveItems .<=. at 420)
    [alternative "column" $ do
      ensure $ top solveItems .==. (bottom parseItems .+. gap)
      ensure $ top renderItems .==. (bottom solveItems .+. gap)
      ensure $ x parseItems .==. x solveItems
      ensure $ x solveItems .==. x renderItems
      ensure $ y solveItems .==. y canvas
      ensure $ x solveItems .>=. at 260
      ensure $ x solveItems .<=. at 540]

  sometimes $ do
    connector (anchor AtBoundary parseItems) (anchor AtBoundary solveItems) $ do
      endMarker ArrowMarker
      style @StrokeWidth (by 2)
    connector (anchor AtBoundary solveItems) (anchor AtBoundary renderItems) $ do
      endMarker ArrowMarker
      style @StrokeWidth (by 2)
