data Value
instance Traceable Value where
  type Payload Value = LInt Value

data Add
instance Traceable Add where
  type Payload Add = LOperator Add

instance Applicable2 Add Value Value where
  type Apply2Result Add Value Value = Value
  applyPayload2 LOperator (LInt leftValue) (LInt rightValue) =
    LInt (leftValue Linear.+ rightValue)

data LeftRole
data RightRole
data AddRole
data ResultRole
data Inputs
data Sum
data Complete

leftKind :: Kind Value
leftKind = kind @LeftRole

rightKind :: Kind Value
rightKind = kind @RightRole

addKind :: Kind Add
addKind = kind @AddRole

resultKind :: Kind Value
resultKind = kind @ResultRole

data Initial where
  Initial :: Block Value %1 -> Block Add %1 -> Block Value %1 -> Initial

domain :: Domain Initial
domain = do
  declareKind leftKind
  declareKind rightKind
  declareKind addKind
  declareKind resultKind
  declareSteps @'[Inputs, Sum, Complete]
  Create leftPending <- create (LInt 20)
  leftValue <- materialize leftKind leftPending
  Create addPending <- create LOperator
  addOperator <- materialize addKind addPending
  Create rightPending <- create (LInt 22)
  rightValue <- materialize rightKind rightPending
  pure (Initial leftValue addOperator rightValue)

program :: Initial %1 -> Program ()
program initial = do
  Initial leftValue addOperator rightValue <- step @Inputs (pure initial)
  result <- step @Sum $ do
    Apply2 resultPending <- apply2 addOperator leftValue rightValue
    materialize resultKind resultPending
  step @Complete $ do
    Destroy <- destroy result
    pure ()

render :: Render ()
render = do
  always $ frame @Inputs
  always $ frame @Sum
  always $ frame @Complete
  width (by 800)
  height (by 450)
  contentFit Both Contain

  leftValues <- select leftKind
  rightValues <- select rightKind
  addOperators <- select addKind
  results <- select resultKind

  expression <- node $ do
    width (by 640)
    height (by 160)
    contentFit Both Contain

    node leftValues $ do
      label <- bindContent
      fitText label
      width (by 132)
      height (by 96)
      xAt (percent 16)
      yAt (percent 50)

    node addOperators $ do
      fitText (text "+")
      width (by 72)
      height (by 72)
      xAt (percent 50)
      yAt (percent 50)
      withoutStyle @Fill

    node rightValues $ do
      label <- bindContent
      fitText label
      width (by 132)
      height (by 96)
      xAt (percent 84)
      yAt (percent 50)

    node results $ do
      label <- bindContent
      fitText label
      width (by 160)
      height (by 112)
      xAt (percent 50)
      yAt (percent 50)
      style @Fill (Hsl (num 132) (num 0.34) (num 0.9))
      style @Stroke (Hsl (num 132) (num 0.5) (num 0.35))
      style @StrokeWidth (by 2)
      style @BorderStyle BorderSolid

  ensure $ center expression .==. center canvas
