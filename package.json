{
  "name": "sverlin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm run prepare:compiler && pnpm run \"/^dev:(web|worker)$/\"",
    "dev:web": "node scripts/run-with-state-lock.mjs node node_modules/vite/bin/vite.js dev",
    "dev:worker": "pnpm run build:worker && node build-worker/index.js",
    "build": "pnpm run prepare:compiler && pnpm exec svelte-kit sync && pnpm exec vite build && pnpm run build:migrate && pnpm run build:worker",
    "build:migrate": "esbuild src/project-migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=build-migrate/index.js",
    "build:worker": "esbuild src/project-worker.ts --bundle --platform=node --format=esm --packages=external --loader:.md=text --outfile=build-worker/index.js",
    "preview": "pnpm run prepare:compiler && node scripts/run-with-state-lock.mjs node node_modules/vite/bin/vite.js preview",
    "start": "node build",
    "prepare": "svelte-kit sync || echo ''",
    "prepare:compiler": "node scripts/prepare-compiler.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "generate:dsl-api-index": "node scripts/dsl-api-index.mjs --write",
    "check:dsl-api-index": "node scripts/dsl-api-index.mjs --check",
    "generate:visualization-types": "node scripts/visualization-types.mjs --write",
    "check:visualization-types": "node scripts/visualization-types.mjs --check",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "compile": "node scripts/run-compile.mjs",
    "lint": "prettier --check . && eslint . && pnpm run check:dsl-api-index && pnpm run check:visualization-types",
    "lint:haskell": "hlint compile/src compile/app compile/test compile/bench compile/test-support",
    "test:unit": "SVERLIN_PROJECT_STORE=file vitest run --configLoader native",
    "test:postgres": "SVERLIN_RUN_POSTGRES_TESTS=1 vitest run src/lib/server/projects/*.postgres.integration.test.ts",
    "test:sverlin-source": "stack --stack-yaml compile/stack.yaml test compile:sverlin-source-test",
    "test:examples": "pnpm run prepare:compiler && SVERLIN_RUN_EXAMPLE_TESTS=1 vitest run src/lib/server/compiler/examples.integration.test.ts --testTimeout=900000",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
    "test:solver": "stack --stack-yaml compile/stack.yaml test compile:solver-test",
    "test": "pnpm run test:unit && pnpm run test:examples",
    "bench:solver": "stack --stack-yaml compile/stack.yaml exec solver-bench --",
    "format": "prettier --write .",
    "format:haskell": "find compile/app compile/src compile/test compile/bench compile/test-support -name '*.hs' -print0 | xargs -0 hindent && find compile/app compile/src compile/test compile/bench compile/test-support -name '*.hs' -print0 | xargs -0 stylish-haskell -i"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.1",
    "@eslint/js": "^9.39.2",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.21.0",
    "@playwright/test": "1.58.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/mcp": "0.1.26",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24",
    "bits-ui": "^2.18.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.1.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.48.2",
    "svelte-check": "^4.3.5",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@lezer/highlight": "^1.2.3",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.2",
    "openai": "^7.5.0",
    "pg-boss": "^12.28.0",
    "postgres": "^3.4.9",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.2"
  }
}
