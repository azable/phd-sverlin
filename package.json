{
  "name": "sverlin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "generate:visualization-types": "bash -o pipefail -c 'cabal run -v0 visualization-types --builddir=compile/dist-newstyle | pnpm exec prettier --parser typescript > src/lib/visualization/generated/visualization-ir.ts.tmp && mv src/lib/visualization/generated/visualization-ir.ts.tmp src/lib/visualization/generated/visualization-ir.ts'",
    "check:visualization-types": "pnpm run generate:visualization-types && git diff --exit-code -- src/lib/visualization/generated/visualization-ir.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "compile": "node scripts/run-compile.mjs",
    "lint": "prettier --check . && eslint .",
    "lint:haskell": "hlint compile/src compile/app compile/test compile/bench compile/test-support",
    "test:unit": "vitest",
    "test:solver": "cabal test -v0 solver-test --builddir=compile/dist-newstyle --test-show-details=direct",
    "test": "npm run test:unit -- --run",
    "bench:solver": "cabal run -v0 solver-bench --builddir=compile/dist-newstyle --",
    "bench:compile": "node scripts/benchmark-compile.mjs",
    "format": "prettier --write .",
    "format:haskell": "find compile/app compile/src compile/test compile/bench compile/test-support -name '*.hs' -print0 | xargs -0 hindent && find compile/app compile/src compile/test compile/bench compile/test-support -name '*.hs' -print0 | xargs -0 stylish-haskell -i"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.1",
    "@eslint/js": "^9.39.2",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.21.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24",
    "bits-ui": "^2.18.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.1.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.48.2",
    "svelte-check": "^4.3.5",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "openai": "^7.5.0",
    "tailwind-merge": "^3.6.0"
  }
}
