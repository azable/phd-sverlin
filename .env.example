# Local PostgreSQL (the devcontainer receives the Compose service URL automatically).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sverlin
SVERLIN_PROJECT_STORE=postgres

# Better Auth. Generate production secrets with `openssl rand -base64 48`.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
SVERLIN_ADMIN_SETUP_TOKEN=replace-with-a-single-use-random-setup-token

# Railway Bucket credentials. Railway reference variables can expose these from
# the attached Bucket to both the web and worker services.
BUCKET=
ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto

# Worker and database tuning. Start with one worker; pg-boss serializes commands
# for each participant if the worker service is scaled later.
SVERLIN_DATABASE_POOL_SIZE=5
SVERLIN_JOB_EXPIRE_SECONDS=1800
SVERLIN_JOB_HEARTBEAT_SECONDS=60
SVERLIN_COMPILE_TIMEOUT_MS=300000

# Optional: only AI-assisted editing requires this.
OPENAI_API_KEY=

SVERLIN_BUILD_SHA=local
