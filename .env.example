# Copy this file to .env. Docker Compose reads it when creating the devcontainer.
# Rebuild or recreate the devcontainer after changing these values.

# Optional AI-assisted editing. Ordinary compilation works without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
CHATBOT_CONFIG=ai-assistant

# Optional local overrides. Compose supplies safe development defaults.
BETTER_AUTH_SECRET=
SVERLIN_ADMIN_SETUP_TOKEN=
POSTGRES_PORT=5432
