# Server-only OpenAI credentials. Never expose these through PUBLIC_* variables.
OPENAI_API_KEY=

# Optional; defaults to gpt-5.6.
OPENAI_MODEL=gpt-5.6

# Optional server-selected chatbot configuration.
CHATBOT_CONFIG=ai-assistant

# Optional guard. The complete artifact audit history is sent to the chatbot;
# requests fail explicitly once its serialized context exceeds this size.
CHATBOT_MAX_CONTEXT_CHARS=500000
