# Copy this file to .env if it does not exist. devenv loads it at shell startup.
# Use shell-compatible assignments; quote values containing spaces or shell syntax.
# After changes, exit/re-enter devenv shell and restart devenv processes.

# Optional AI-assisted editing. Ordinary compilation works without a key.
OPENAI_API_KEY=
# Each provider call may use at most three minutes. Repair attempts only begin
# when this complete allowance remains in a timed study phase.
CHATBOT_REQUEST_TIMEOUT_MS=180000

# Optional local overrides. devenv supplies development defaults for empty values.
BETTER_AUTH_SECRET=
# Leave empty to use devenv's local PostgreSQL database and allocated port.
DATABASE_URL=
# To change the local service's base port, set services.postgres.port in the
# ignored devenv.local.nix (see README); POSTGRES_PORT from Compose is obsolete.
