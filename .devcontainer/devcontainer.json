{
  "customizations": {
    "vscode": {
      "extensions": [
        "mkhl.direnv",
        "jnoortheen.nix-ide",
        "svelte.svelte-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "haskell.haskell",
        "0xCD.stylish-hindent"
      ]
    },
    "zed": {
      "extensions": []
    }
  },
  "forwardPorts": [
    5173
  ],
  "image": "ghcr.io/cachix/devenv/devcontainer@sha256:233b726a6570777be9403cca1e177a4f61fc772b540032bca41f3aabb85aa4e9",
  "initializeCommand": [
    "sh",
    "-c",
    "set -eu\numask 077\nmkdir -p \"$1/.local/devcontainer/opencode\"\nconfig=\"$1/.local/devcontainer/opencode/opencode.json\"\n# Pre-create a writable destination so cp cannot inherit Nix store modes.\ntouch \"$config\"\nchmod 600 \"$config\"\ncp -L \"$HOME/.config/opencode/opencode.json\" \"$config\"\n",
    "opencode-host-config",
    "${localWorkspaceFolder}"
  ],
  "mounts": [
    "type=bind,source=${localWorkspaceFolder}/.local/devcontainer/opencode/opencode.json,target=/home/vscode/.config/opencode/opencode.json,readonly",
    "type=bind,source=${localEnv:HOME}/.local/share/opencode/auth.json,target=${containerWorkspaceFolder}/.local/share/opencode/auth.json"
  ],
  "name": "Sverlin",
  "overrideCommand": false,
  "portsAttributes": {
    "5173": {
      "label": "Sverlin",
      "onAutoForward": "notify",
      "requireLocalPort": true
    }
  },
  "updateContentCommand": "devenv tasks run sverlin:setup"
}
