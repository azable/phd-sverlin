{
  "name": "Sverlin",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "remoteUser": "root",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "pnpmVersion": "10.12.1"
    }
  },

  "runArgs": ["--security-opt=seccomp=unconfined"],

  "containerEnv": {
    "CABAL_DIR": "${containerWorkspaceFolder}/.cache/cabal",
    "CABAL_CONFIG": "${containerWorkspaceFolder}/.devcontainer/cabal.config",
    "XDG_CACHE_HOME": "${containerWorkspaceFolder}/.cache",
    "XDG_STATE_HOME": "${containerWorkspaceFolder}/.local/state"
  },

  "remoteEnv": {
    "SVERLIN_COMPILE_TIMEOUT_MS": "300000"
  },

  "forwardPorts": [5173],

  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "esbenp.prettier-vscode",
        "haskell.haskell",
        "openai.chatgpt"
      ],

      "settings": {
        "files.associations": {
          "*.sverlin": "haskell",
          "*.hs": "haskell",
          "*.lhs": "haskell",
          "*.hs-boot": "haskell",
          "*.hsc": "haskell",
          "*.cabal": "cabal",
          "cabal.project": "plaintext"
        },

        "haskell.manageHLS": "PATH",
        "haskell.formattingProvider": "stylish-haskell",

        "[haskell]": {
          "editor.defaultFormatter": "haskell.haskell",
          "editor.formatOnSave": false
        },

        "[svelte]": {
          "editor.defaultFormatter": "svelte.svelte-vscode"
        },

        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },

  "mounts": [
    "source=${devcontainerId}-cabal-cache,target=${containerWorkspaceFolder}/.cache/cabal,type=volume",
    "source=${devcontainerId}-cabal-state,target=${containerWorkspaceFolder}/.local/state/cabal,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind,readonly"
  ],

  "postCreateCommand": "npm install -g @openai/codex@latest && pnpm install --frozen-lockfile && mkdir -p outputs .cache/cabal/packages .cache/cabal/logs .local/state/cabal/store && node scripts/run-cabal.mjs update && pnpm run prepare:compiler"
}
