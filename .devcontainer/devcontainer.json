{
  "name": "Sverlin",

  "dockerComposeFile": "../compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/phd-sverlin",

  "remoteUser": "root",

  "containerEnv": {
    "STACK_ROOT": "/opt/sverlin-stack-seed",
    "XDG_CACHE_HOME": "${containerWorkspaceFolder}/.cache",
    "XDG_STATE_HOME": "${containerWorkspaceFolder}/.local/state",
    "SVERLIN_SCRATCH_DIR": "/tmp/sverlin"
  },

  "remoteEnv": {
    "SVERLIN_COMPILE_TIMEOUT_MS": "300000"
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/dirien/devcontainer-feature-codex/codex:0": {}
  },

  "forwardPorts": [5173],

  "portsAttributes": {
    "5173": {
      "label": "Sverlin development server",
      "onAutoForward": "notify",
      "requireLocalPort": true
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "esbenp.prettier-vscode",
        "haskell.haskell",
        "openai.chatgpt"
      ],

      "settings": {
        "files.associations": {
          "*.sverlin": "haskell",
          "*.hs": "haskell",
          "*.lhs": "haskell",
          "*.hs-boot": "haskell",
          "*.hsc": "haskell",
          "*.cabal": "cabal"
        },

        "haskell.manageHLS": "PATH",
        "haskell.formattingProvider": "stylish-haskell",

        "[haskell]": {
          "editor.defaultFormatter": "haskell.haskell",
          "editor.formatOnSave": false
        },

        "[svelte]": {
          "editor.defaultFormatter": "svelte.svelte-vscode"
        },

        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },

  "postCreateCommand": "pnpm install --frozen-lockfile && pnpm run db:migrate"
}
