cabal-version:      3.8
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'compile' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               compile

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Alex Zable

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         alex.zable@unimelb.edu.au

-- A copyright notice.
-- copyright:
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
extra-source-files:
    cbits/sverlin_harfbuzz.h
    fonts/README.md
    test/fixtures/Invalid.sverlin

data-files:
    fonts/**/*.ttf
    fonts/**/OFL.txt

common warnings
    ghc-options: -Wall

common app-dependencies
    build-depends:    base >=4.18.3.0 && <4.23,
                      array,
                      containers,
                      random,
                      mtl,
                      linear-base,
                      aeson,
                      aeson-pretty,
                      bytestring,
                      optparse-applicative

    default-language: GHC2024

library sverlin-internal
    -- Import common warning flags.
    import:           warnings
    import:           app-dependencies

    visibility:       private

    build-depends:    hmatrix >=0.20.2 && <0.21,
                      MIP >=0.2.0.1 && <0.3,
                      binary,
                      cryptohash-sha256 >=0.11.102 && <0.12,
                      data-default-class,
                      filepath,
                      scientific,
                      skylighting-core ==0.14.7,
                      temporary,
                      text

    pkgconfig-depends: harfbuzz >=3.3

    exposed-modules:
        Sverlin
        Sverlin.Compiler
        Sverlin.Linear
        LinearTrace.Choreography
        LinearTrace.Core
        Solver
        LinearTrace.Visualization.Compile
        LinearTrace.Visualization.IR
        LinearTrace.Visualization.Options
        LinearTrace.Visualization.Resource
        LinearTrace.Visualization.Target
        LinearTrace.Visualization.Typography
        Sverlin.Internal.Semantic
        Sverlin.Internal.Semantic.Generator
        Sverlin.Internal.Compiler
        Sverlin.Internal.Render
        Sverlin.Internal.Render.Compile
        Sverlin.Internal.Render.Typography
        Sverlin.Syntax

    other-modules:
        LinearTrace.Choreography.Constraint
        LinearTrace.Choreography.Box
        LinearTrace.Choreography.Graph
        LinearTrace.Choreography.Layout
        LinearTrace.Choreography.Match
        LinearTrace.Choreography.Node
        LinearTrace.Choreography.Style
        LinearTrace.Choreography.Variable
        LinearTrace.Core.Internal
        LinearTrace.Core.Query
        LinearTrace.View.Access
        LinearTrace.View.Box
        LinearTrace.View.Build
        LinearTrace.View.Graph
        LinearTrace.View.Primitives
        LinearTrace.View.Solve
        LinearTrace.View.Style
        LinearTrace.View.StyleProfile
        LinearTrace.View.Template
        LinearTrace.Visualization.FontCatalog
        LinearTrace.Visualization.CodeHighlight
        LinearTrace.Visualization.HarfBuzz
        Paths_compile
        Solver.Affine
        Solver.Choice
        Solver.Categorical
        Solver.Constraint
        Solver.DesignSpace
        Solver.Expr
        Solver.Highs
        Solver.Problem
        Solver.Random
        Solver.Sample
    hs-source-dirs:   src

    c-sources:        cbits/sverlin_harfbuzz.c

    include-dirs:     cbits

library
    import:             warnings

    build-depends:      base >=4.18.3.0 && <4.23,
                        compile:sverlin-internal,
                        linear-base

    reexported-modules:
        Sverlin,
        Sverlin.Compiler,
        Sverlin.Linear,
        Solver

    default-language:   GHC2024

executable compile-app
    -- Import common warning flags.
    import:           warnings
    import:           app-dependencies

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    other-modules:
        Sverlin.Interpreter
        Sverlin.Source

    build-depends:    compile,
                      compile:sverlin-internal,
                      directory,
                      filepath,
                      hint >=0.9.0.9 && <0.10,
                      temporary

    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: GHC2024

executable visualization-types
    import:             warnings
    import:             app-dependencies

    main-is:            GenerateVisualizationTypes.hs

    other-modules:
        GenerateVisualizationTypes.TypeScript

    build-depends:      compile,
                        compile:sverlin-internal,
                        template-haskell

    hs-source-dirs:     app

    default-language:   GHC2024

executable solver-bench
    import:           warnings

    main-is:          SolverBench.hs

    build-depends:    aeson,
                      base >=4.18.3.0 && <4.23,
                      bytestring,
                      compile

    hs-source-dirs:   bench,
                      test-support

    other-modules:
        Solver.TestFixtures

    default-language: GHC2024

test-suite solver-test
    import:           warnings

    type:             exitcode-stdio-1.0
    main-is:          SolverTest.hs

    build-depends:    base >=4.18.3.0 && <4.23,
                      containers,
                      compile:sverlin-internal,
                      linear-base,
                      tasty,
                      tasty-hunit

    hs-source-dirs:   test,
                      test-support

    other-modules:
        Choreography.TestFixtures
        Solver.TestFixtures

    default-language: GHC2024

test-suite sverlin-source-test
    import:           warnings

    type:             exitcode-stdio-1.0
    main-is:          SverlinSourceTest.hs

    build-depends:    base >=4.18.3.0 && <4.23,
                      tasty,
                      tasty-hunit

    hs-source-dirs:   test,
                      app

    other-modules:
        Sverlin.Source

    default-language: GHC2024

test-suite semantic-test
    import:           warnings

    type:             exitcode-stdio-1.0
    main-is:          SemanticTestMain.hs

    build-depends:    base >=4.18.3.0 && <4.23,
                      bytestring,
                      compile:sverlin-internal,
                      containers,
                      linear-base,
                      random,
                      tasty,
                      tasty-hunit

    hs-source-dirs:   test

    other-modules:
        RenderGuardTest
        SemanticTest
        TypographyTest

    default-language: GHC2024
