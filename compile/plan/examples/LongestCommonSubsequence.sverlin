-- Longest common subsequence (LCS) for the proposed API.
-- This planning source is intentionally not compiled by the current compiler.
--
-- Every DP row owns a semantic set of cells through InRow. The same Cell kind
-- and RightOf relation kind are reused by every row. Render uses `within` to
-- restrict those selections to the current row before validating a sequence.
-- Generator prepares the expected DP table; Program traces the cell writes but
-- does not independently prove the recurrence in this concise replay.

data Row
instance Traceable Row where
  type Payload Row = LUnit Row

data RowLabel
instance Traceable RowLabel where
  type Payload RowLabel = LString RowLabel

data Cell
instance Traceable Cell where
  type Payload Cell = LUnit Cell

data CellValue
instance Traceable CellValue where
  type Payload CellValue = LInt CellValue

data InputLine
instance Traceable InputLine where
  type Payload InputLine = LString InputLine

data ResultLine
instance Traceable ResultLine where
  type Payload ResultLine = LString ResultLine

data RowRole
data RowLabelRole
data CellRole
data CellValueRole
data LeftInputRole
data RightInputRole
data ResultRole
data InRowRole
data NextRowRole
data RightOfRole
data CellDependencyRole
data ResultNextRole
data LcsScenarioRole

rowKind :: Kind Row
rowKind = kind @RowRole

rowLabelKind :: Kind RowLabel
rowLabelKind = kind @RowLabelRole

cellKind :: Kind Cell
cellKind = kind @CellRole

cellValueKind :: Kind CellValue
cellValueKind = kind @CellValueRole

leftInputKind :: Kind InputLine
leftInputKind = kind @LeftInputRole

rightInputKind :: Kind InputLine
rightInputKind = kind @RightInputRole

resultKind :: Kind ResultLine
resultKind = kind @ResultRole

inRow :: RelationKind Row Cell
inRow = orderedRelation @InRowRole

nextRow :: RelationKind Row Row
nextRow = orderedRelation @NextRowRole

rightOf :: RelationKind Cell Cell
rightOf = orderedRelation @RightOfRole

cellDependency :: RelationKind Cell Cell
cellDependency = orderedRelation @CellDependencyRole

resultNext :: RelationKind Cell Cell
resultNext = orderedRelation @ResultNextRole

data LongestCommonSubsequence
data InitializeStrings
data BuildRows
data FillCell
data BuildDependencies
data TraceResult
data FinishLcs

data EdgePlan where
  NoEdges :: EdgePlan
  NextEdge :: Int %1 -> Int %1 -> EdgePlan %1 -> EdgePlan

data MembershipPlan where
  NoMemberships :: MembershipPlan
  NextMembership :: Int %1 -> Int %1 -> MembershipPlan %1 -> MembershipPlan

data TextPlan where
  NoTexts :: TextPlan
  NextText :: String %1 -> TextPlan %1 -> TextPlan

data ValuePlan where
  NoValues :: ValuePlan
  NextValue :: Int %1 -> ValuePlan %1 -> ValuePlan

data ResultPlan where
  ResultPlan :: String %1 -> ResultPlan

data LcsCase where
  LcsCase ::
    String %1 ->
    String %1 ->
    TextPlan %1 ->
    EdgePlan %1 ->
    ValuePlan %1 ->
    MembershipPlan %1 ->
    EdgePlan %1 ->
    EdgePlan %1 ->
    ValuePlan %1 ->
    EdgePlan %1 ->
    ResultPlan %1 ->
    LcsCase

lcsGenerator :: Generator LcsCase
lcsGenerator = do
  leftLength <- between 3 7
  rightLength <- between 3 7
  leftChars <- listOf leftLength leftLength (elementOf 'A' ['B', 'C', 'D'])
  rightChars <- listOf rightLength rightLength (elementOf 'A' ['B', 'C', 'D'])
  let table = lcsTable leftChars rightChars
  let rowCount = length leftChars + 1
  let columnCount = length rightChars + 1
  let path = resultCells leftChars rightChars table
  pure
    (LcsCase
       leftChars
       rightChars
       (textPlan ("∅" : map (: []) leftChars))
       (edgePlan [(row, row + 1) | row <- [0 .. rowCount - 2]])
       (valuePlan (replicate (rowCount * columnCount) 0))
       (membershipPlan
          [(row, cellIndex columnCount row column) | row <- [0 .. rowCount - 1], column <- [0 .. columnCount - 1]])
       (edgePlan (rightEdges rowCount columnCount))
       (edgePlan (dependencyEdges leftChars rightChars))
       (valuePlan (concat table))
       (edgePlan (pairwise path))
       (ResultPlan (lcsText leftChars rightChars table)))

domain :: Domain InitialState
domain = do
  declareKind rowKind
  declareKind rowLabelKind
  declareKind cellKind
  declareKind cellValueKind
  declareKind leftInputKind
  declareKind rightInputKind
  declareKind resultKind
  declareRelation inRow
  declareRelation nextRow
  declareRelation rightOf
  declareRelation cellDependency
  declareRelation resultNext
  declareSteps
    @'[ LongestCommonSubsequence
      , InitializeStrings
      , BuildRows
      , FillCell
      , BuildDependencies
      , TraceResult
      , FinishLcs
      ]

  LcsCase leftValue rightValue rowLabels rowEdges initialValues memberships horizontalEdges dependencyPlan fillPlan resultEdges resultText <-
    variable @LcsScenarioRole lcsGenerator

  Create leftPending <- create (LString leftValue)
  leftBlock <- materialize leftInputKind leftPending
  Create rightPending <- create (LString rightValue)
  rightBlock <- materialize rightInputKind rightPending

  rows0 <- initializeRows rowLabels
  rows1 <- relateAll nextRow rowEdges rows0
  cells0 <- initializeCells initialValues
  RelatedLists rows2 cells1 <- relateAllMemberships inRow memberships rows1 cells0
  cells2 <- relateAll rightOf horizontalEdges cells1

  -- The blank table and its row/column structure are initial state. Dependency
  -- and result-path edges are derived state, so only their linear plans cross
  -- into Program; the relations are added by their named steps.
  pure
    (InitialState
       (InputBlocks leftBlock rightBlock)
       rows2
       cells2
       dependencyPlan
       fillPlan
       resultEdges
       resultText)

--------------------------------------------------------------------------------
-- Linear storage helpers
--------------------------------------------------------------------------------

data Stored owner value where
  Stored :: Block owner %1 -> Slot owner value %1 -> Stored owner value

data StoredList owner value where
  StoredNil :: StoredList owner value
  StoredCons :: Stored owner value %1 -> StoredList owner value %1 -> StoredList owner value

data InputBlocks where
  InputBlocks :: Block InputLine %1 -> Block InputLine %1 -> InputBlocks

data ResultState where
  ResultState :: StoredList Cell CellValue %1 -> Block ResultLine %1 -> ResultState

data RelatedStored source sourceValue target targetValue where
  RelatedStored ::
    Stored source sourceValue %1 ->
    Stored target targetValue %1 ->
    RelatedStored source sourceValue target targetValue

data RelatedExternal source sourceValue target targetValue where
  RelatedExternal ::
    Stored source sourceValue %1 ->
    StoredList target targetValue %1 ->
    RelatedExternal source sourceValue target targetValue

data RelatedLists source sourceValue target targetValue where
  RelatedLists ::
    StoredList source sourceValue %1 ->
    StoredList target targetValue %1 ->
    RelatedLists source sourceValue target targetValue

data RelatedTail owner value where
  RelatedTail :: Stored owner value %1 -> StoredList owner value %1 -> RelatedTail owner value

initializeStored ::
  (Traceable owner, Traceable value) =>
  Kind owner ->
  Payload owner %1 ->
  Kind value ->
  Payload value %1 ->
  Domain (Stored owner value)
initializeStored ownerKind ownerPayload valueKind valuePayload = do
  Create ownerPending <- create ownerPayload
  owner <- materialize ownerKind ownerPending
  Create valuePending <- create valuePayload
  value <- materialize valueKind valuePending
  Seal owner1 slot <- seal owner value
  pure (Stored owner1 slot)

relateStored ::
  RelationKind source target ->
  Stored source sourceValue %1 ->
  Stored target targetValue %1 ->
  Domain (RelatedStored source sourceValue target targetValue)
relateStored relationKind (Stored source sourceSlot) (Stored target targetSlot) = do
  Relate sourceSlot1 targetSlot1 <- relate relationKind sourceSlot targetSlot
  pure (RelatedStored (Stored source sourceSlot1) (Stored target targetSlot1))

relateExternalAt ::
  RelationKind source target ->
  Stored source sourceValue %1 ->
  Int %1 ->
  StoredList target targetValue %1 ->
  Domain (RelatedExternal source sourceValue target targetValue)
relateExternalAt relationKind source 0 (StoredCons target rest) = do
  RelatedStored source1 target1 <- relateStored relationKind source target
  pure (RelatedExternal source1 (StoredCons target1 rest))
relateExternalAt relationKind source index (StoredCons target rest) = do
  RelatedExternal source1 remaining <- relateExternalAt relationKind source (index Linear.- 1) rest
  pure (RelatedExternal source1 (StoredCons target remaining))

relateListsAt ::
  RelationKind source target ->
  Int %1 ->
  Int %1 ->
  StoredList source sourceValue %1 ->
  StoredList target targetValue %1 ->
  Domain (RelatedLists source sourceValue target targetValue)
relateListsAt relationKind 0 targetIndex (StoredCons source rest) targets = do
  RelatedExternal source1 targets1 <- relateExternalAt relationKind source targetIndex targets
  pure (RelatedLists (StoredCons source1 rest) targets1)
relateListsAt relationKind sourceIndex targetIndex (StoredCons current rest) targets = do
  RelatedLists rest1 targets1 <- relateListsAt relationKind (sourceIndex Linear.- 1) targetIndex rest targets
  pure (RelatedLists (StoredCons current rest1) targets1)

relateSourceToLater ::
  RelationKind owner owner ->
  Stored owner value %1 ->
  Int %1 ->
  StoredList owner value %1 ->
  Domain (RelatedTail owner value)
relateSourceToLater relationKind source 0 (StoredCons target tailValues) = do
  RelatedStored source1 target1 <- relateStored relationKind source target
  pure (RelatedTail source1 (StoredCons target1 tailValues))
relateSourceToLater relationKind source offset (StoredCons current tailValues) = do
  RelatedTail source1 remaining <- relateSourceToLater relationKind source (offset Linear.- 1) tailValues
  pure (RelatedTail source1 (StoredCons current remaining))

relateAt ::
  RelationKind owner owner ->
  Int %1 ->
  Int %1 ->
  StoredList owner value %1 ->
  Domain (StoredList owner value)
relateAt relationKind 0 distance (StoredCons source rest) = do
  RelatedTail source1 rest1 <- relateSourceToLater relationKind source distance rest
  pure (StoredCons source1 rest1)
relateAt relationKind sourceIndex distance (StoredCons current rest) = do
  rest1 <- relateAt relationKind (sourceIndex Linear.- 1) distance rest
  pure (StoredCons current rest1)

relateAll ::
  RelationKind owner owner ->
  EdgePlan %1 ->
  StoredList owner value %1 ->
  Domain (StoredList owner value)
relateAll _ NoEdges values = pure values
relateAll relationKind (NextEdge source distance rest) values = do
  values1 <- relateAt relationKind source distance values
  relateAll relationKind rest values1

relateAllMemberships ::
  RelationKind source target ->
  MembershipPlan %1 ->
  StoredList source sourceValue %1 ->
  StoredList target targetValue %1 ->
  Domain (RelatedLists source sourceValue target targetValue)
relateAllMemberships _ NoMemberships sources targets = pure (RelatedLists sources targets)
relateAllMemberships relationKind (NextMembership source target rest) sources targets = do
  RelatedLists sources1 targets1 <- relateListsAt relationKind source target sources targets
  relateAllMemberships relationKind rest sources1 targets1

relateStoredProgram ::
  RelationKind source target ->
  Stored source sourceValue %1 ->
  Stored target targetValue %1 ->
  Program (RelatedStored source sourceValue target targetValue)
relateStoredProgram relationKind (Stored source sourceSlot) (Stored target targetSlot) = do
  Relate sourceSlot1 targetSlot1 <- relate relationKind sourceSlot targetSlot
  pure (RelatedStored (Stored source sourceSlot1) (Stored target targetSlot1))

relateSourceToLaterProgram ::
  RelationKind owner owner ->
  Stored owner value %1 ->
  Int %1 ->
  StoredList owner value %1 ->
  Program (RelatedTail owner value)
relateSourceToLaterProgram relationKind source 0 (StoredCons target tailValues) = do
  RelatedStored source1 target1 <- relateStoredProgram relationKind source target
  pure (RelatedTail source1 (StoredCons target1 tailValues))
relateSourceToLaterProgram relationKind source offset (StoredCons current tailValues) = do
  RelatedTail source1 remaining <- relateSourceToLaterProgram relationKind source (offset Linear.- 1) tailValues
  pure (RelatedTail source1 (StoredCons current remaining))

relateAtProgram ::
  RelationKind owner owner ->
  Int %1 ->
  Int %1 ->
  StoredList owner value %1 ->
  Program (StoredList owner value)
relateAtProgram relationKind 0 offset (StoredCons source rest) = do
  RelatedTail source1 rest1 <- relateSourceToLaterProgram relationKind source offset rest
  pure (StoredCons source1 rest1)
relateAtProgram relationKind index offset (StoredCons current rest) = do
  rest1 <- relateAtProgram relationKind (index Linear.- 1) offset rest
  pure (StoredCons current rest1)

relateAllProgram ::
  RelationKind owner owner ->
  EdgePlan %1 ->
  StoredList owner value %1 ->
  Program (StoredList owner value)
relateAllProgram _ NoEdges values = pure values
relateAllProgram relationKind (NextEdge source distance rest) values = do
  values1 <- relateAtProgram relationKind source distance values
  relateAllProgram relationKind rest values1

destroyStored :: Stored owner value %1 -> Program ()
destroyStored (Stored owner slot) = do
  Unseal owner1 value <- unseal owner slot
  Destroy <- destroy value
  Destroy <- destroy owner1
  pure ()

destroyStoredList :: StoredList owner value %1 -> Program ()
destroyStoredList StoredNil = pure ()
destroyStoredList (StoredCons current rest) = do
  destroyStored current
  destroyStoredList rest

--------------------------------------------------------------------------------
-- Pure finite DP preparation
--------------------------------------------------------------------------------

lcsTable :: String -> String -> [[Int]]
lcsTable leftValue rightValue = table
  where
    rowCount = length leftValue + 1
    columnCount = length rightValue + 1
    table = [[entry row column | column <- [0 .. columnCount - 1]] | row <- [0 .. rowCount - 1]]
    entry 0 _ = 0
    entry _ 0 = 0
    entry row column
      | leftValue !! (row - 1) == rightValue !! (column - 1) = table !! (row - 1) !! (column - 1) + 1
      | otherwise = max (table !! (row - 1) !! column) (table !! row !! (column - 1))

cellIndex :: Int -> Int -> Int -> Int
cellIndex columnCount row column = row * columnCount + column

rightEdges :: Int -> Int -> [(Int, Int)]
rightEdges rowCount columnCount =
  [ (cellIndex columnCount row column, cellIndex columnCount row (column + 1))
  | row <- [0 .. rowCount - 1]
  , column <- [0 .. columnCount - 2]
  ]

dependencyEdges :: String -> String -> [(Int, Int)]
dependencyEdges leftValue rightValue = concat
  [ dependencies row column
  | row <- [1 .. length leftValue]
  , column <- [1 .. length rightValue]
  ]
  where
    columnCount = length rightValue + 1
    current row column = cellIndex columnCount row column
    dependencies row column
      | leftValue !! (row - 1) == rightValue !! (column - 1) =
          [(current (row - 1) (column - 1), current row column)]
      | otherwise =
          [ (current (row - 1) column, current row column)
          , (current row (column - 1), current row column)
          ]

resultCells :: String -> String -> [[Int]] -> [Int]
resultCells leftValue rightValue table = reverse (go (length leftValue) (length rightValue))
  where
    columnCount = length rightValue + 1
    go 0 _ = []
    go _ 0 = []
    go row column
      | leftValue !! (row - 1) == rightValue !! (column - 1) =
          cellIndex columnCount row column : go (row - 1) (column - 1)
      | table !! (row - 1) !! column >= table !! row !! (column - 1) = go (row - 1) column
      | otherwise = go row (column - 1)

pairwise :: [a] -> [(a, a)]
pairwise (firstValue : secondValue : rest) = (firstValue, secondValue) : pairwise (secondValue : rest)
pairwise _ = []

lcsText :: String -> String -> [[Int]] -> String
lcsText leftValue rightValue table = reverse (go (length leftValue) (length rightValue))
  where
    go 0 _ = []
    go _ 0 = []
    go row column
      | leftValue !! (row - 1) == rightValue !! (column - 1) =
          leftValue !! (row - 1) : go (row - 1) (column - 1)
      | table !! (row - 1) !! column >= table !! row !! (column - 1) = go (row - 1) column
      | otherwise = go row (column - 1)

edgePlan :: [(Int, Int)] -> EdgePlan
edgePlan [] = NoEdges
edgePlan ((source, target) : rest) =
  NextEdge source (target - source - 1) (edgePlan rest)

membershipPlan :: [(Int, Int)] -> MembershipPlan
membershipPlan [] = NoMemberships
membershipPlan ((source, target) : rest) =
  NextMembership source target (membershipPlan rest)

textPlan :: [String] -> TextPlan
textPlan [] = NoTexts
textPlan (value : rest) = NextText value (textPlan rest)

valuePlan :: [Int] -> ValuePlan
valuePlan [] = NoValues
valuePlan (value : rest) = NextValue value (valuePlan rest)

--------------------------------------------------------------------------------
-- Program
--------------------------------------------------------------------------------

initializeRows :: TextPlan %1 -> Domain (StoredList Row RowLabel)
initializeRows NoTexts = pure StoredNil
initializeRows (NextText label rest) = do
  row <- initializeStored rowKind LUnit rowLabelKind (LString label)
  rows <- initializeRows rest
  pure (StoredCons row rows)

initializeCells :: ValuePlan %1 -> Domain (StoredList Cell CellValue)
initializeCells NoValues = pure StoredNil
initializeCells (NextValue value rest) = do
  cell <- initializeStored cellKind LUnit cellValueKind (LInt value)
  cells <- initializeCells rest
  pure (StoredCons cell cells)

writeCell :: Int %1 -> Stored Cell CellValue %1 -> Program (Stored Cell CellValue)
writeCell nextValue (Stored owner slot) = do
  Unseal owner1 oldValue <- unseal owner slot
  Create rawPending <- create (LInt nextValue)
  Replace nextPending <- replace oldValue rawPending
  nextBlock <- materialize cellValueKind nextPending
  Seal owner2 slot1 <- seal owner1 nextBlock
  pure (Stored owner2 slot1)

fillCells :: ValuePlan %1 -> StoredList Cell CellValue %1 -> Program (StoredList Cell CellValue)
fillCells NoValues StoredNil = pure StoredNil
fillCells (NextValue value values) (StoredCons current rest) = do
  current1 <- step @FillCell (writeCell value current)
  rest1 <- fillCells values rest
  pure (StoredCons current1 rest1)

data InitialState where
  InitialState ::
    InputBlocks %1 ->
    StoredList Row RowLabel %1 ->
    StoredList Cell CellValue %1 ->
    EdgePlan %1 ->
    ValuePlan %1 ->
    EdgePlan %1 ->
    ResultPlan %1 ->
    InitialState

program :: InitialState %1 -> Program ()
program (InitialState inputs initialRows initialCells dependencyPlan fillPlan resultEdges resultPlan) = step @LongestCommonSubsequence $ do
  InputBlocks leftBlock rightBlock <- step @InitializeStrings (pure inputs)
  rows <- step @BuildRows (pure initialRows)
  -- Locations and recurrence relations exist before values change. Each FillCell
  -- replaces one occupant while its stable Cell owner keeps every relation.
  cells <- step @BuildDependencies (relateAllProgram cellDependency dependencyPlan initialCells)
  cellsFilled <- fillCells fillPlan cells
  ResultState cells1 result <- step @TraceResult $ do
    ResultPlan resultText <- pure resultPlan
    tracedCells <- relateAllProgram resultNext resultEdges cellsFilled
    Create resultPending <- create (LString resultText)
    resultBlock <- materialize resultKind resultPending
    pure (ResultState tracedCells resultBlock)

  step @FinishLcs $ do
    Destroy <- destroy leftBlock
    Destroy <- destroy rightBlock
    Destroy <- destroy result
    destroyStoredList cells1
    destroyStoredList rows

--------------------------------------------------------------------------------
-- Render
--------------------------------------------------------------------------------

render :: Render ()
render = do
  canvasWidth <- variable @Span
  canvasHeight <- variable @Span
  ensure $ canvasWidth .>=. by 960
  ensure $ canvasWidth .<=. by 1920
  ensure $ canvasHeight .>=. by 540
  ensure $ canvasHeight .<=. by 1080
  width canvasWidth
  height canvasHeight
  aspectRatio 16 9
  padding (uniform (by 28))
  contentFit Both Contain

  always $ frame @BuildDependencies
  always $ frame @TraceResult
  sometimes $ frame @FillCell
  cellSize <- variable @Span
  columnGap <- variable @Span
  rowGap <- variable @Span
  panelGap <- variable @Span
  ensure $ cellSize .>=. by 42
  ensure $ cellSize .<=. by 68
  ensure $ columnGap .>=. by 6
  ensure $ columnGap .<=. by 18
  ensure $ rowGap .>=. by 8
  ensure $ rowGap .<=. by 22
  ensure $ panelGap .>=. by 20
  ensure $ panelGap .<=. by 44

  rows <- select rowKind
  rowLabels <- select rowLabelKind
  rowLinks <- select nextRow
  rowOrder <- asSequence rowLinks rows
  membershipLinks <- select inRow

  grid <- node $ do
    padding (uniform (by 20))
    contentFit Both Hug

    node rows $ do
      rowPosition <- rankOf rowOrder
      padding (uniform (by 6))
      contentFit Both Hug

      node rowLabels $ do
        label <- bindContent
        fitText label
        width cellSize
        height cellSize
        contentFit Both Contain
        style @Fill (Hsl (num 220) (num 0.18) (num 0.94))
        style @Radius (by 8)

      -- The lexical scope contains exactly this row's cells and induced
      -- RightOf edges. Other rows using the same kinds are not silently mixed.
      within membershipLinks rows $ do
        rowCells <- select cellKind
        rowValues <- select cellValueKind
        horizontalLinks <- select rightOf
        columnOrder <- asSequence horizontalLinks rowCells

        node rowCells $ do
          columnPosition <- rankOf columnOrder
          ensure $ left rowCells .==. right rowLabels .+. columnGap .+. (cellSize .+. columnGap) .*. asScalar columnPosition
          ensure $ y rowCells .==. y rowLabels
          width cellSize
          height cellSize
          padding (uniform (by 6))
          contentFit Both Contain
          style @Fill (Hsl (num 202) (num 0.30) (num 0.92))
          style @Stroke (Hsl (num 202) (num 0.50) (num 0.40))
          style @BorderStyle BorderSolid
          style @StrokeWidth (by 2)
          style @Radius (by 9)

          node rowValues $ do
            score <- payloadScalar rowValues
            scoreText <- bindContent
            fitText scoreText
            contentFit Both Contain
            ensure $ height rowValues .>=. by 24 .+. by 2 .*. score

          coordinateLabel <- sometimes $ node $
            content (text "(" <> asText rowPosition <> text "," <> asText columnPosition <> text ")")
          ensure $ top coordinateLabel .==. bottom rowValues .+. by 4
          ensure $ x coordinateLabel .==. x rowValues

    relation rowLinks $ do
      previous <- first rowLinks
      next <- second rowLinks
      ensure $ top next .==. bottom previous .+. rowGap
      ensure $ x next .==. x previous

  leftInputs <- select leftInputKind
  rightInputs <- select rightInputKind
  inputs <- node $ do
    padding (uniform (by 12))
    node leftInputs $ do
      value <- bindContent
      fitText (text "left:  " <> value)
    node rightInputs $ do
      value <- bindContent
      fitText (text "right: " <> value)
      ensure $ top rightInputs .==. bottom leftInputs .+. by 8
      ensure $ left rightInputs .==. left leftInputs

  dependencies <- select cellDependency
  oneOf "dependency-detail"
    (alternative "table-only" $ pure ())
    [alternative "show-dependencies" $
      relation dependencies $ do
        source <- first dependencies
        target <- second dependencies
        connector (anchor AtBoundary source) (anchor AtBoundary target) $ do
          style @Stroke (Hsl (num 270) (num 0.42) (num 0.54))
          style @Opacity (num 0.55)
          style @StrokeWidth (by 1)
          endMarker ArrowMarker]

  resultLinks <- select resultNext
  relation resultLinks $ do
    previous <- first resultLinks
    next <- second resultLinks
    connector (anchor AtBoundary previous) (anchor AtBoundary next) $ do
      style @Stroke (Hsl (num 18) (num 0.76) (num 0.48))
      style @StrokeWidth (by 4)
      endMarker ArrowMarker

  results <- select resultKind
  node results $ do
    value <- bindContent
    fitText (text "LCS: " <> value)
    padding (uniform (by 14))
    style @Fill (Hsl (num 145) (num 0.34) (num 0.90))
    style @Stroke (Hsl (num 145) (num 0.52) (num 0.38))
    style @BorderStyle BorderSolid
    style @StrokeWidth (by 2)
    style @Radius (by 12)
    ensure $ top results .==. bottom grid .+. panelGap
    ensure $ x results .==. x grid
    ensure $ separatedBy panelGap grid results

  ensure $ top grid .==. bottom inputs .+. panelGap
  ensure $ x grid .==. x inputs
  ensure $ separatedBy panelGap inputs grid
  ensure $ x grid .==. x canvas
