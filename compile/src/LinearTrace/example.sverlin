-- Illustrative body-only linear search for the target API in API_plan.md.
-- Unified typed steps, text trees, and Render-controlled frames are proposed APIs.

data Number

type instance Payload Number = LInt Number

data Condition

type instance Payload Condition = LBool Condition

data TargetCell

type instance Payload TargetCell = LUnit TargetCell

data IndexCell

type instance Payload IndexCell = LUnit IndexCell

data ElementCell

type instance Payload ElementCell = LUnit ElementCell

data Add = Add

type instance Payload Add = LOperator Add Add

instance CoreOperator Add where
  operatorPayloadText Add = "+"
  persistOperatorPayload Add = Ur Add

instance Applicable2 Add Number Number where
  type Apply2Result Add Number Number = Number
  applyPayload2 (LOperator Add) = applyLinear2Into (Linear.+)

data Equal = Equal

type instance Payload Equal = LOperator Equal Equal

instance CoreOperator Equal where
  operatorPayloadText Equal = "=="
  persistOperatorPayload Equal = Ur Equal

instance Applicable2 Equal Number Number where
  type Apply2Result Equal Number Number = Condition
  applyPayload2 (LOperator Equal) = applyLinear2Into (Linear.==)

type LinearSearch = "linear-search"
type InitializeTarget = LinearSearch / "initialize-target"
type InitializeElements = LinearSearch / "initialize-elements"
type CreateElement = InitializeElements / "create-element"
type InitializeIndex = LinearSearch / "initialize-index"
type SearchIteration = LinearSearch / "search-iteration"
type FinishSearch = LinearSearch / "finish"

type CreateValue parent = parent / "create-value"
type CreateCell parent = parent / "create-cell"
type AssignValue parent = parent / "assign"
type CreateStoredChildren = '["create-value", "create-cell", "assign"]

type CheckRemainingElements = SearchIteration / "check-remaining-elements"
type ReadTarget = SearchIteration / "read-target"
type ReadElement = SearchIteration / "read-element"
type CompareTarget = SearchIteration / "compare-target"
type CreateEqualOperator = CompareTarget / "create-operator"
type ApplyEquality = CompareTarget / "apply-equality"
type ReturnFound = SearchIteration / "return-found"
type ReturnNotFound = SearchIteration / "return-not-found"

type IncrementIndex = SearchIteration / "increment-index"
type ReadIndexForIncrement = IncrementIndex / "read-index"
type CreateOne = IncrementIndex / "create-one"
type CreateAddOperator = IncrementIndex / "create-operator"
type AddOneToIndex = IncrementIndex / "add"
type WriteIndex = IncrementIndex / "write"

type DestroyTarget = FinishSearch / "destroy-target"
type DestroyIndex = FinishSearch / "destroy-index"
type DestroyElements = FinishSearch / "destroy-elements"
type DestroyElement = DestroyElements / "destroy-element"

domain :: Domain ()
domain = do
  declarePayload @Number
  declarePayload @Condition
  declarePayload @TargetCell
  declarePayload @IndexCell
  declarePayload @ElementCell
  declareOperator Add
  declareOperator Equal
  declareBranches @'[InitializeTarget, InitializeIndex, CreateElement] @CreateStoredChildren
  declareSteps
    @'[ LinearSearch
      , InitializeElements
      , SearchIteration
      , CheckRemainingElements
      , ReadTarget
      , ReadElement
      , CompareTarget
      , CreateEqualOperator
      , ApplyEquality
      , ReturnFound
      , ReturnNotFound
      , IncrementIndex
      , ReadIndexForIncrement
      , CreateOne
      , CreateAddOperator
      , AddOneToIndex
      , WriteIndex
      , FinishSearch
      , DestroyTarget
      , DestroyIndex
      , DestroyElements
      , DestroyElement
      ]

data Stored owner value where
  Stored :: Block owner %1 -> Slot owner value %1 -> Stored owner value

data ReadStored owner value where
  ReadStored :: Stored owner value %1 -> Block value %1 -> ReadStored owner value

data StoredList value where
  NoStoredValues :: StoredList value
  MoreStoredValue :: Int -> Stored ElementCell value %1 -> StoredList value %1 -> StoredList value

data ListView value where
  EmptyList :: ListView value
  NextValue :: Int -> Stored ElementCell value %1 -> StoredList value %1 -> ListView value

data SearchOutcome = FoundAt Int | NotFound

data SearchResult where
  SearchResult ::
    SearchOutcome ->
    Stored TargetCell Number %1 ->
    Stored IndexCell Number %1 ->
    StoredList Number %1 ->
    SearchResult

createStored ::
  forall parent owner value.
  (KnownSymbol parent, Traceable owner, Traceable value) =>
  Query ->
  Payload owner %1 ->
  Query ->
  Payload value %1 ->
  Program (Stored owner value)
createStored ownerFacts ownerPayload valueFacts valuePayload = step @parent $ do
  value <- step @(CreateValue parent) $ do
    Create pending <- create valuePayload
    materialize valueFacts pending

  cell <- step @(CreateCell parent) $ do
    Create pending <- create ownerPayload
    materialize ownerFacts pending

  step @(AssignValue parent) $ do
    Seal cell1 slot <- seal cell value
    return (Stored cell1 slot)

readStored :: (Traceable owner, Traceable value) => Query -> Stored owner value %1 -> Program (ReadStored owner value)
readStored query (Stored owner slot) = do
  Unseal owner1 value <- unseal owner slot
  Copy value1 copyPending <- copy value
  valueCopy <- materialize query copyPending
  Seal owner2 slot1 <- seal owner1 value1
  return (ReadStored (Stored owner2 slot1) valueCopy)

writeStored :: (Traceable owner, Traceable value) => Query -> Stored owner value %1 -> Pending value %1 -> Program (Stored owner value)
writeStored query (Stored owner slot) replacement = do
  Unseal owner1 oldValue <- unseal owner slot
  Replace storedPending <- replace oldValue replacement
  storedValue <- materialize query storedPending
  Seal owner2 slot1 <- seal owner1 storedValue
  return (Stored owner2 slot1)

destroyStored :: (Traceable owner, Traceable value) => Stored owner value %1 -> Program ()
destroyStored (Stored owner slot) = do
  Unseal owner1 value <- unseal owner slot
  Destroy <- destroy value
  Destroy <- destroy owner1
  return ()

initializeTarget :: Int -> Program (Stored TargetCell Number)
initializeTarget target = createStored @InitializeTarget #targetCell LUnit #target (LInt target)

initializeIndex :: Program (Stored IndexCell Number)
initializeIndex = createStored @InitializeIndex #indexCell LUnit #index (LInt 0)

initializeElements :: [Int] -> Program (StoredList Number)
initializeElements values = step @InitializeElements (go 0 values)
  where
    go :: Int -> [Int] -> Program (StoredList Number)
    go _ [] = return NoStoredValues
    go position (value : rest) = do
      element <- createStored @CreateElement (#elementCell <&> #index @: position) LUnit (#element <&> #index @: position) (LInt value)
      elements <- go (position + 1) rest
      return (MoreStoredValue position element elements)

inspectElements :: StoredList value %1 -> Program (ListView value)
inspectElements elements = step @CheckRemainingElements $
  case elements of
    NoStoredValues -> return EmptyList
    MoreStoredValue position element rest -> return (NextValue position element rest)

compareTarget :: Block Number %1 -> Block Number %1 -> Program Bool
compareTarget element target = step @CompareTarget $ do
  equal <- step @CreateEqualOperator $ do
    Create pending <- create @Equal (LOperator Equal)
    materialize #equalOperator pending

  step @ApplyEquality $ do
    Apply2 conditionPending <- apply2 equal element target
    condition <- materialize #comparison conditionPending
    Use result <- use condition
    case result of
      OneUse (LBool matched) -> return matched

incrementIndex :: Stored IndexCell Number %1 -> Program (Stored IndexCell Number)
incrementIndex index = step @IncrementIndex $ do
  ReadStored index1 indexProbe <- step @ReadIndexForIncrement (readStored #indexRead index)

  one <- step @CreateOne $ do
    Create pending <- create @Number (LInt 1)
    materialize #increment pending

  add <- step @CreateAddOperator $ do
    Create pending <- create @Add (LOperator Add)
    materialize #addOperator pending

  nextPending <- step @AddOneToIndex $ do
    Apply2 pending <- apply2 add indexProbe one
    return pending

  step @WriteIndex (writeStored #index index1 nextPending)

searchLoop ::
  Stored TargetCell Number %1 ->
  Stored IndexCell Number %1 ->
  StoredList Number %1 ->
  Program SearchResult
searchLoop target index elements = step @SearchIteration $ do
  view <- inspectElements elements
  case view of
    EmptyList -> step @ReturnNotFound $ return (SearchResult NotFound target index NoStoredValues)
    NextValue position element rest -> do
      ReadStored target1 targetProbe <- step @ReadTarget (readStored #targetRead target)
      ReadStored element1 elementProbe <- step @ReadElement (readStored (#elementRead <&> #index @: position) element)
      matched <- compareTarget elementProbe targetProbe
      case matched of
        True ->
          step @ReturnFound $
            return (SearchResult (FoundAt position) target1 index (MoreStoredValue position element1 rest))
        False -> do
          index1 <- incrementIndex index
          SearchResult outcome target2 index2 searchedRest <- searchLoop target1 index1 rest
          return (SearchResult outcome target2 index2 (MoreStoredValue position element1 searchedRest))

destroyStoredList :: StoredList Number %1 -> Program ()
destroyStoredList elements =
  case elements of
    NoStoredValues -> return ()
    MoreStoredValue _ element rest -> do
      step @DestroyElement (destroyStored element)
      destroyStoredList rest

finishSearch :: SearchResult %1 -> Program ()
finishSearch (SearchResult _ target index elements) = step @FinishSearch $ do
  step @DestroyTarget (destroyStored target)
  step @DestroyIndex (destroyStored index)
  step @DestroyElements (destroyStoredList elements)

program :: Program ()
program = step @LinearSearch $ do
  target <- initializeTarget 7
  elements <- initializeElements [4, 9, 2, 7]
  index <- initializeIndex
  result <- searchLoop target index elements
  finishSearch result

pseudocode :: TextTree
pseudocode =
  block @LinearSearch
    (do
      literal "find "
      fragmentMany
        @'[InitializeTarget, CreateValue InitializeTarget, CreateCell InitializeTarget, AssignValue InitializeTarget]
        "target"
      literal " in "
      fragmentMany
        @'[InitializeElements, CreateElement, CreateValue CreateElement, CreateCell CreateElement, AssignValue CreateElement]
        "values"
      literal ":")
    $ do
      line @InitializeIndex $
        fragmentMany
          @'[InitializeIndex, CreateValue InitializeIndex, CreateCell InitializeIndex, AssignValue InitializeIndex]
          "set index to zero"

      block @SearchIteration
        (do
          literal "while "
          fragment @CheckRemainingElements "values remain"
          literal ":")
        $ do
          block @CompareTarget
            (do
              literal "if "
              fragment @ReadElement "current value"
              fragmentMany @'[CreateEqualOperator, ApplyEquality] " equals "
              fragment @ReadTarget "target"
              literal ":")
            $ do
              line @ReturnFound $ fragment @ReturnFound "return index"

          line @IncrementIndex $
            fragmentMany
              @'[ReadIndexForIncrement, CreateOne, CreateAddOperator, AddOneToIndex, WriteIndex]
              "increase index by one"

      line @ReturnNotFound $ fragment @ReturnNotFound "return not found"

cSource :: TextTree
cSource =
  delimitedBlock @LinearSearch
    (do
      literal "int linear_search(int "
      fragmentMany
        @'[InitializeElements, CreateElement, CreateValue CreateElement, CreateCell CreateElement, AssignValue CreateElement]
        "A[]"
      literal ", int "
      fragment @InitializeElements "n"
      literal ", int "
      fragmentMany
        @'[InitializeTarget, CreateValue InitializeTarget, CreateCell InitializeTarget, AssignValue InitializeTarget]
        "target"
      literal ") {")
    (literal "}")
    $ do
      delimitedBlock @SearchIteration
        (do
          literal "for ("
          fragmentMany
            @'[InitializeIndex, CreateValue InitializeIndex, CreateCell InitializeIndex, AssignValue InitializeIndex]
            "int i = 0"
          literal "; "
          fragment @CheckRemainingElements "i < n"
          literal "; "
          fragmentMany
            @'[IncrementIndex, ReadIndexForIncrement, CreateOne, CreateAddOperator, AddOneToIndex, WriteIndex]
            "i++"
          literal ") {")
        (literal "}")
        $ do
          delimitedBlock @CompareTarget
            (do
              literal "if ("
              fragment @ReadElement "A[i]"
              fragmentMany @'[CreateEqualOperator, ApplyEquality] " == "
              fragment @ReadTarget "target"
              literal ") {")
            (literal "}")
            $ do
              line @ReturnFound $ do
                literal "return "
                fragment @ReturnFound "i"
                literal ";"

      line @ReturnNotFound $ do
        literal "return "
        fragment @ReturnNotFound "-1"
        literal ";"

type PresentationFrames =
  '[ InitializeTarget
   , InitializeElements
   , InitializeIndex
   , CheckRemainingElements
   , CompareTarget
   , IncrementIndex
   , ReturnFound
   , ReturnNotFound
   , FinishSearch
   ]

render :: Render ()
render = do
  width (by 1000)
  height (by 640)
  contentFit Both Contain
  framesAt @PresentationFrames

  source <- textNodes cSource

  node source $ do
    left (at 36)
    top (at 32)
    width (by 500)
    height (by 560)
    style @FontFamily (FixedStyle FontIBMPlexMono)
    style @WhiteSpace (FixedStyle WhiteSpacePre)

  Bound targetLabel <- bindContent
  Selected targets <- select @Number (#target <&> payload targetLabel)
  Bound indexLabel <- bindContent
  Selected indices <- select @Number (#index <&> payload indexLabel)
  Bound elementLabel <- bindContent
  Bound elementIndex <- bindInt
  Selected elements <- select @Number (#element <&> #index @: elementIndex <&> payload elementLabel)
  Bound targetReadLabel <- bindContent
  Selected targetReads <- select @Number (#targetRead <&> payload targetReadLabel)
  Bound elementReadLabel <- bindContent
  Bound elementReadIndex <- bindInt
  Selected elementReads <- select @Number (#elementRead <&> #index @: elementReadIndex <&> payload elementReadLabel)
  Bound comparisonLabel <- bindContent
  Selected comparisons <- select @Condition (#comparison <&> payload comparisonLabel)

  node targets $ do
    fitText targetLabel
    left (at 580)
    top (at 72)
    width (by 120)
    height (by 88)
    styleFamily "target"

  node indices $ do
    fitText indexLabel
    left (at 780)
    top (at 72)
    width (by 120)
    height (by 88)
    styleFamily "index"

  node elements $ do
    fitText elementLabel
    left (at 560 + shift (asScalar elementIndex * num 96))
    top (at 210)
    width (by 80)
    height (by 72)
    styleFamily "element"

  node targetReads $ do
    fitText targetReadLabel
    left (at 620)
    top (at 350)
    width (by 100)
    height (by 76)
    styleFamily "read"

  node elementReads $ do
    fitText elementReadLabel
    left (at 790)
    top (at 350)
    width (by 100)
    height (by 76)
    styleFamily "read"

  node comparisons $ do
    fitText comparisonLabel
    left (at 705)
    top (at 480)
    width (by 100)
    height (by 76)
    styleFamily "comparison"

  during @CompareTarget $ mappedFragments @CompareTarget source $ do
    style @FontWeight (FixedStyle FontWeightBold)

  during @IncrementIndex $ mappedFragments @IncrementIndex source $ do
    style @FontWeight (FixedStyle FontWeightBold)
