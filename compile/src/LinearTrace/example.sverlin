-- Illustrative body-only linear search for the target API in API_plan.md.
-- This planning source is not compiled by the current application.
--
-- Domain declaration/packaging, typed Program steps, Render frame selection,
-- and the public Slot occupant-to-owner projection remain open API details.
-- Their working spellings below are deliberately confined to this example.

data Number

instance Traceable Number where
  type Payload Number = LInt Number

data Condition

instance Traceable Condition where
  type Payload Condition = LBool Condition

data TargetCell

instance Traceable TargetCell where
  type Payload TargetCell = LUnit TargetCell

data IndexCell

instance Traceable IndexCell where
  type Payload IndexCell = LUnit IndexCell

data ElementCell

instance Traceable ElementCell where
  type Payload ElementCell = LUnit ElementCell

data Add

instance Traceable Add where
  type Payload Add = LOperator Add Add

instance Applicable2 Add Number Number where
  type Apply2Result Add Number Number = Number
  applyPayload2 LOperator (LInt leftValue) (LInt rightValue) =
    LInt (leftValue Linear.+ rightValue)

data Equal

instance Traceable Equal where
  type Payload Equal = LOperator Equal Equal

instance Applicable2 Equal Number Number where
  type Apply2Result Equal Number Number = Condition
  applyPayload2 LOperator (LInt leftValue) (LInt rightValue) =
    LBool (leftValue Linear.== rightValue)

--------------------------------------------------------------------------------
-- Domain declarations
--------------------------------------------------------------------------------

-- These are Domain-provided values. Their construction and packaging syntax is
-- still open; free strings and overloaded-label fallbacks are not alternatives.
targetKind :: Kind Number
indexKind :: Kind Number
elementKind :: Kind Number
indexReadKind :: Kind Number
targetReadKind :: Kind Number
elementReadKind :: Kind Number
comparisonKind :: Kind Condition
targetCellKind :: Kind TargetCell
indexCellKind :: Kind IndexCell
elementCellKind :: Kind ElementCell
adjacent :: RelationKind ElementCell ElementCell

type LinearSearch = "linear-search"
type InitializeTarget = LinearSearch / "initialize-target"
type InitializeElements = LinearSearch / "initialize-elements"
type CreateElement = InitializeElements / "create-element"
type RelateNextElement = InitializeElements / "relate-next"
type InitializeIndex = LinearSearch / "initialize-index"
type SearchIteration = LinearSearch / "search-iteration"
type FinishSearch = LinearSearch / "finish"

type CreateValue parent = parent / "create-value"
type CreateCell parent = parent / "create-cell"
type AssignValue parent = parent / "assign"
type CreateStoredChildren = '["create-value", "create-cell", "assign"]

type CheckRemainingElements = SearchIteration / "check-remaining-elements"
type ReadTarget = SearchIteration / "read-target"
type ReadElement = SearchIteration / "read-element"
type CompareTarget = SearchIteration / "compare-target"
type CreateEqualOperator = CompareTarget / "create-operator"
type ApplyEquality = CompareTarget / "apply-equality"
type ReturnFound = SearchIteration / "return-found"
type ReturnNotFound = SearchIteration / "return-not-found"

type IncrementIndex = SearchIteration / "increment-index"
type ReadIndexForIncrement = IncrementIndex / "read-index"
type CreateOne = IncrementIndex / "create-one"
type CreateAddOperator = IncrementIndex / "create-operator"
type AddOneToIndex = IncrementIndex / "add"
type WriteIndex = IncrementIndex / "write"

type DestroyTarget = FinishSearch / "destroy-target"
type DestroyIndex = FinishSearch / "destroy-index"
type DestroyElements = FinishSearch / "destroy-elements"
type UnrelateNextElement = DestroyElements / "unrelate-next"
type DestroyElement = DestroyElements / "destroy-element"

domain :: Domain ()
domain = do
  -- Working declaration syntax; final constructors and packaging remain open.
  declareOperator @Add
  declareOperator @Equal
  declareKind targetKind
  declareKind indexKind
  declareKind elementKind
  declareKind indexReadKind
  declareKind targetReadKind
  declareKind elementReadKind
  declareKind comparisonKind
  declareKind targetCellKind
  declareKind indexCellKind
  declareKind elementCellKind
  declareRelation adjacent -- ordered previous-to-next endpoints
  declareBranches @'[InitializeTarget, InitializeIndex, CreateElement] @CreateStoredChildren
  declareSteps
    @'[ LinearSearch
      , InitializeElements
      , RelateNextElement
      , SearchIteration
      , CheckRemainingElements
      , ReadTarget
      , ReadElement
      , CompareTarget
      , CreateEqualOperator
      , ApplyEquality
      , ReturnFound
      , ReturnNotFound
      , IncrementIndex
      , ReadIndexForIncrement
      , CreateOne
      , CreateAddOperator
      , AddOneToIndex
      , WriteIndex
      , FinishSearch
      , DestroyTarget
      , DestroyIndex
      , DestroyElements
      , UnrelateNextElement
      , DestroyElement
      ]

--------------------------------------------------------------------------------
-- Linear storage and adjacency
--------------------------------------------------------------------------------

data Stored owner value where
  Stored :: Block owner %1 -> Slot owner value %1 -> Stored owner value

data ReadStored owner value where
  ReadStored :: Stored owner value %1 -> Block value %1 -> ReadStored owner value

data RelatedStored value where
  RelatedStored ::
    Stored ElementCell value %1 ->
    Stored ElementCell value %1 ->
    Relation %1 ->
    RelatedStored value

data UnrelatedStored value where
  UnrelatedStored ::
    Stored ElementCell value %1 ->
    Stored ElementCell value %1 ->
    UnrelatedStored value

data NonEmptyStoredList value where
  LastStoredValue :: Stored ElementCell value %1 -> NonEmptyStoredList value
  MoreStoredValue ::
    Stored ElementCell value %1 ->
    Relation %1 ->
    NonEmptyStoredList value %1 ->
    NonEmptyStoredList value

data StoredList value where
  NoStoredValues :: StoredList value
  StoredValues :: NonEmptyStoredList value %1 -> StoredList value

-- The list stores one linear Relation beside every adjacent pair. It stores no
-- integer layout index; Render validates the chain and derives positions.

data ListView value where
  LastValue :: Stored ElementCell value %1 -> ListView value
  NextValue ::
    Stored ElementCell value %1 ->
    Relation %1 ->
    NonEmptyStoredList value %1 ->
    ListView value

data UnlinkedHead value where
  UnlinkedHead ::
    Stored ElementCell value %1 ->
    NonEmptyStoredList value %1 ->
    UnlinkedHead value

createStored ::
  forall parent owner value.
  (KnownSymbol parent, Traceable owner, Traceable value) =>
  Kind owner ->
  Payload owner %1 ->
  Kind value ->
  Payload value %1 ->
  Program (Stored owner value)
createStored ownerKind ownerPayload valueKind valuePayload = step @parent $ do
  value <- step @(CreateValue parent) $ do
    Create pending <- create valuePayload
    materialize valueKind pending

  cell <- step @(CreateCell parent) $ do
    Create pending <- create ownerPayload
    materialize ownerKind pending

  step @(AssignValue parent) $ do
    Seal cell1 slot <- seal cell value
    return (Stored cell1 slot)

readStored ::
  (Traceable owner, Traceable value) =>
  Kind value ->
  Stored owner value %1 ->
  Program (ReadStored owner value)
readStored readKind (Stored owner slot) = do
  Unseal owner1 value <- unseal owner slot
  Copy value1 copyPending <- copy value
  valueCopy <- materialize readKind copyPending
  Seal owner2 slot1 <- seal owner1 value1
  return (ReadStored (Stored owner2 slot1) valueCopy)

writeStored ::
  (Traceable owner, Traceable value) =>
  Kind value ->
  Stored owner value %1 ->
  Pending value %1 ->
  Program (Stored owner value)
writeStored storedKind (Stored owner slot) replacement = do
  Unseal owner1 oldValue <- unseal owner slot
  Replace storedPending <- replace oldValue replacement
  storedValue <- materialize storedKind storedPending
  Seal owner2 slot1 <- seal owner1 storedValue
  return (Stored owner2 slot1)

destroyStored ::
  (Traceable owner, Traceable value) =>
  Stored owner value %1 ->
  Program ()
destroyStored (Stored owner slot) = do
  Unseal owner1 value <- unseal owner slot
  Destroy <- destroy value
  Destroy <- destroy owner1
  return ()

relateStored ::
  RelationKind ElementCell ElementCell ->
  Stored ElementCell value %1 ->
  Stored ElementCell value %1 ->
  Program (RelatedStored value)
relateStored relationKind (Stored leftOwner leftSlot) (Stored rightOwner rightSlot) = do
  Relate leftSlot1 rightSlot1 relation <- relate relationKind leftSlot rightSlot
  return
    (RelatedStored
       (Stored leftOwner leftSlot1)
       (Stored rightOwner rightSlot1)
       relation)

unrelateStored ::
  Relation %1 ->
  Stored ElementCell value %1 ->
  Stored ElementCell value %1 ->
  Program (UnrelatedStored value)
unrelateStored relation (Stored leftOwner leftSlot) (Stored rightOwner rightSlot) = do
  Unrelate leftSlot1 rightSlot1 <- unrelate relation leftSlot rightSlot
  return
    (UnrelatedStored
       (Stored leftOwner leftSlot1)
       (Stored rightOwner rightSlot1))

prependStored ::
  Stored ElementCell value %1 ->
  NonEmptyStoredList value %1 ->
  Program (NonEmptyStoredList value)
prependStored current rest =
  case rest of
    LastStoredValue next -> do
      RelatedStored current1 next1 relation <- relateStored adjacent current next
      return (MoreStoredValue current1 relation (LastStoredValue next1))
    MoreStoredValue next nextRelation remaining -> do
      RelatedStored current1 next1 relation <- relateStored adjacent current next
      return
        (MoreStoredValue
           current1
           relation
           (MoreStoredValue next1 nextRelation remaining))

inspectElements :: NonEmptyStoredList value %1 -> Program (ListView value)
inspectElements elements =
  case elements of
    LastStoredValue element -> return (LastValue element)
    MoreStoredValue element relation rest -> return (NextValue element relation rest)

unlinkHead ::
  Relation %1 ->
  Stored ElementCell value %1 ->
  NonEmptyStoredList value %1 ->
  Program (UnlinkedHead value)
unlinkHead relation current rest =
  case rest of
    LastStoredValue next -> do
      UnrelatedStored current1 next1 <- unrelateStored relation current next
      return (UnlinkedHead current1 (LastStoredValue next1))
    MoreStoredValue next nextRelation remaining -> do
      UnrelatedStored current1 next1 <- unrelateStored relation current next
      return
        (UnlinkedHead
           current1
           (MoreStoredValue next1 nextRelation remaining))

--------------------------------------------------------------------------------
-- Program
--------------------------------------------------------------------------------

data SearchOutcome = FoundAt Int | NotFound

data SearchResult where
  SearchResult ::
    SearchOutcome ->
    Stored TargetCell Number %1 ->
    Stored IndexCell Number %1 ->
    StoredList Number %1 ->
    SearchResult

data NonEmptySearchResult where
  NonEmptySearchResult ::
    SearchOutcome ->
    Stored TargetCell Number %1 ->
    Stored IndexCell Number %1 ->
    NonEmptyStoredList Number %1 ->
    NonEmptySearchResult

data ComparedElement where
  ComparedElement ::
    Stored TargetCell Number %1 ->
    Stored ElementCell Number %1 ->
    Bool ->
    ComparedElement

initializeTarget :: Int -> Program (Stored TargetCell Number)
initializeTarget target =
  createStored @InitializeTarget targetCellKind LUnit targetKind (LInt target)

initializeIndex :: Program (Stored IndexCell Number)
initializeIndex =
  createStored @InitializeIndex indexCellKind LUnit indexKind (LInt 0)

initializeElements :: [Int] -> Program (StoredList Number)
initializeElements values = step @InitializeElements (go values)
  where
    go :: [Int] -> Program (StoredList Number)
    go [] = return NoStoredValues
    go (value : rest) = do
      current <-
        createStored @CreateElement elementCellKind LUnit elementKind (LInt value)
      remaining <- go rest
      case remaining of
        NoStoredValues -> return (StoredValues (LastStoredValue current))
        StoredValues nonEmpty -> do
          linked <- step @RelateNextElement (prependStored current nonEmpty)
          return (StoredValues linked)

compareTarget :: Block Number %1 -> Block Number %1 -> Program Bool
compareTarget element target = step @CompareTarget $ do
  equal <- step @CreateEqualOperator $ do
    Create pending <- create @Equal LOperator
    commit pending

  step @ApplyEquality $ do
    Apply2 conditionPending <- apply2 equal element target
    condition <- materialize comparisonKind conditionPending
    Use result <- use condition
    case result of
      OneUse (LBool matched) -> return matched

compareElement ::
  Stored TargetCell Number %1 ->
  Stored ElementCell Number %1 ->
  Program ComparedElement
compareElement target element = do
  ReadStored target1 targetProbe <- step @ReadTarget (readStored targetReadKind target)
  ReadStored element1 elementProbe <- step @ReadElement (readStored elementReadKind element)
  matched <- compareTarget elementProbe targetProbe
  return (ComparedElement target1 element1 matched)

incrementIndex :: Stored IndexCell Number %1 -> Program (Stored IndexCell Number)
incrementIndex index = step @IncrementIndex $ do
  ReadStored index1 indexProbe <-
    step @ReadIndexForIncrement (readStored indexReadKind index)

  one <- step @CreateOne $ do
    Create pending <- create @Number (LInt 1)
    commit pending

  add <- step @CreateAddOperator $ do
    Create pending <- create @Add LOperator
    commit pending

  nextPending <- step @AddOneToIndex $ do
    Apply2 pending <- apply2 add indexProbe one
    return pending

  step @WriteIndex (writeStored indexKind index1 nextPending)

searchNonEmpty ::
  Int ->
  Stored TargetCell Number %1 ->
  Stored IndexCell Number %1 ->
  NonEmptyStoredList Number %1 ->
  Program NonEmptySearchResult
searchNonEmpty position target index elements = step @SearchIteration $ do
  view <- step @CheckRemainingElements (inspectElements elements)
  case view of
    LastValue element -> do
      ComparedElement target1 element1 matched <- compareElement target element
      case matched of
        True ->
          step @ReturnFound $
            return
              (NonEmptySearchResult
                 (FoundAt position)
                 target1
                 index
                 (LastStoredValue element1))
        False -> do
          index1 <- incrementIndex index
          step @ReturnNotFound $
            return
              (NonEmptySearchResult
                 NotFound
                 target1
                 index1
                 (LastStoredValue element1))
    NextValue element relation rest -> do
      ComparedElement target1 element1 matched <- compareElement target element
      case matched of
        True ->
          step @ReturnFound $
            return
              (NonEmptySearchResult
                 (FoundAt position)
                 target1
                 index
                 (MoreStoredValue element1 relation rest))
        False -> do
          index1 <- incrementIndex index
          NonEmptySearchResult outcome target2 index2 searchedRest <-
            searchNonEmpty (position + 1) target1 index1 rest
          return
            (NonEmptySearchResult
               outcome
               target2
               index2
               (MoreStoredValue element1 relation searchedRest))

searchLoop ::
  Stored TargetCell Number %1 ->
  Stored IndexCell Number %1 ->
  StoredList Number %1 ->
  Program SearchResult
searchLoop target index elements =
  case elements of
    NoStoredValues ->
      step @SearchIteration $
        step @ReturnNotFound $
          return (SearchResult NotFound target index NoStoredValues)
    StoredValues nonEmpty -> do
      NonEmptySearchResult outcome target1 index1 searched <-
        searchNonEmpty 0 target index nonEmpty
      return (SearchResult outcome target1 index1 (StoredValues searched))

destroyNonEmpty :: NonEmptyStoredList Number %1 -> Program ()
destroyNonEmpty elements =
  case elements of
    LastStoredValue element -> step @DestroyElement (destroyStored element)
    MoreStoredValue element relation rest -> do
      UnlinkedHead element1 rest1 <-
        step @UnrelateNextElement (unlinkHead relation element rest)
      step @DestroyElement (destroyStored element1)
      destroyNonEmpty rest1

destroyStoredList :: StoredList Number %1 -> Program ()
destroyStoredList elements =
  case elements of
    NoStoredValues -> return ()
    StoredValues nonEmpty -> destroyNonEmpty nonEmpty

finishSearch :: SearchResult %1 -> Program ()
finishSearch (SearchResult _ target index elements) = step @FinishSearch $ do
  step @DestroyTarget (destroyStored target)
  step @DestroyIndex (destroyStored index)
  step @DestroyElements (destroyStoredList elements)

program :: Program ()
program = step @LinearSearch $ do
  target <- initializeTarget 7
  elements <- initializeElements [4, 9, 2, 7]
  index <- initializeIndex
  result <- searchLoop target index elements
  finishSearch result

--------------------------------------------------------------------------------
-- Composed source text
--------------------------------------------------------------------------------

line ::
  Choice FontFamily ->
  Span ->
  TextBuilder () ->
  Render (SelectionBinding (Selected GeneratedNode))
line codeFont codeSize textRecipe =
  node $ do
    width (by 500)
    height (by 28)
    style @FontFamily (VariableStyle codeFont)
    style @FontSize codeSize
    fitText textRecipe

indent :: Selected parent -> Selected child -> Render ()
indent parent child = ensure $ left child .==. left parent + shift 24

sameIndent :: Selected reference -> Selected lineNode -> Render ()
sameIndent reference lineNode = ensure $ left lineNode .==. left reference

after :: Selected upper -> Selected lower -> Render ()
after upper lower = ensure $ top lower .==. bottom upper + shift 4

cSource :: Render ()
cSource = do
  Variable codeFont <- fontChoice (fontKind Monospace)
  Variable codeSize <- variable @Span
  ensure $ codeSize .>=. by 14
  ensure $ codeSize .<=. by 20

  Selected functionLine <- line codeFont codeSize $ do
    literal "int linear_search(int "
    fragmentMany
      @'[InitializeElements, CreateElement, CreateValue CreateElement, CreateCell CreateElement, AssignValue CreateElement, RelateNextElement]
      "A[]"
    literal ", int "
    fragment @InitializeElements "n"
    literal ", int "
    fragmentMany
      @'[InitializeTarget, CreateValue InitializeTarget, CreateCell InitializeTarget, AssignValue InitializeTarget]
      "target"
    literal ") {"

  Selected loopLine <- line codeFont codeSize $ do
    literal "for ("
    fragmentMany
      @'[InitializeIndex, CreateValue InitializeIndex, CreateCell InitializeIndex, AssignValue InitializeIndex]
      "int i = 0"
    literal "; "
    fragment @CheckRemainingElements "i < n"
    literal "; "
    fragmentMany
      @'[IncrementIndex, ReadIndexForIncrement, CreateOne, CreateAddOperator, AddOneToIndex, WriteIndex]
      "i++"
    literal ") {"

  Selected comparisonLine <- line codeFont codeSize $ do
    literal "if ("
    fragment @ReadElement "A[i]"
    fragmentMany @'[CompareTarget, CreateEqualOperator, ApplyEquality] " == "
    fragment @ReadTarget "target"
    literal ") {"

  Selected foundLine <- line codeFont codeSize $ do
    literal "return "
    fragment @ReturnFound "i"
    literal ";"

  Selected closeComparison <- line codeFont codeSize $ literal "}"
  Selected closeLoop <- line codeFont codeSize $ literal "}"

  Selected notFoundLine <- line codeFont codeSize $ do
    literal "return "
    fragment @ReturnNotFound "-1"
    literal ";"

  Selected closeFunction <- line codeFont codeSize $ literal "}"

  ensure $ left functionLine .==. at 36
  ensure $ top functionLine .==. at 32
  indent functionLine loopLine
  after functionLine loopLine
  indent loopLine comparisonLine
  after loopLine comparisonLine
  indent comparisonLine foundLine
  after comparisonLine foundLine
  sameIndent comparisonLine closeComparison
  after foundLine closeComparison
  sameIndent loopLine closeLoop
  after closeComparison closeLoop
  sameIndent loopLine notFoundLine
  after closeLoop notFoundLine
  sameIndent functionLine closeFunction
  after notFoundLine closeFunction

--------------------------------------------------------------------------------
-- Render
--------------------------------------------------------------------------------

type PresentationFrames =
  '[ InitializeTarget
   , InitializeElements
   , InitializeIndex
   , CheckRemainingElements
   , CompareTarget
   , IncrementIndex
   , ReturnFound
   , ReturnNotFound
   , FinishSearch
   ]

render :: Render ()
render = do
  width (by 1000)
  height (by 640)
  contentFit Both Contain

  -- Working step/frame syntax; the exact step API remains open.
  framesAt @PresentationFrames
  cSource

  Selected targets <- select targetKind
  node targets $ do
    Bound targetLabel <- bindContent
    fitText targetLabel
    left (at 580)
    top (at 72)
    width (by 120)
    height (by 88)
    styleFamily "target"

  Selected indices <- select indexKind
  node indices $ do
    Bound indexLabel <- bindContent
    fitText indexLabel
    left (at 780)
    top (at 72)
    width (by 120)
    height (by 88)
    styleFamily "index"

  Selected elementCells <- select elementCellKind
  Selected adjacentRelations <- select adjacent
  orderedElements <- asSequence adjacentRelations elementCells

  Variable elementSpacing <- variable @Span
  ensure $ elementSpacing .>=. by 88
  ensure $ elementSpacing .<=. by 112

  node elementCells $ do
    position <- positionOf orderedElements
    width (by 80)
    height (by 72)
    styleFamily "element-cell"
    ensure $ x elementCells .==. at 600 + elementSpacing * asScalar position
    ensure $ y elementCells .==. at 246

  -- The planned Slot projection keeps each current Number occupant at its
  -- ElementCell owner's stable bounds. The exact public projection helper, or
  -- whether this alignment is automatic, remains to be named.
  Selected elements <- select elementKind
  node elements $ do
    Bound elementLabel <- bindContent
    fitText elementLabel
    styleFamily "element-value"

  Selected targetReads <- select targetReadKind
  node targetReads $ do
    Bound targetReadLabel <- bindContent
    fitText targetReadLabel
    left (at 620)
    top (at 350)
    width (by 100)
    height (by 76)
    styleFamily "read"

  Selected elementReads <- select elementReadKind
  node elementReads $ do
    Bound elementReadLabel <- bindContent
    fitText elementReadLabel
    left (at 790)
    top (at 350)
    width (by 100)
    height (by 76)
    styleFamily "read"

  Selected comparisons <- select comparisonKind
  node comparisons $ do
    Bound comparisonLabel <- bindContent
    fitText comparisonLabel
    left (at 705)
    top (at 480)
    width (by 100)
    height (by 76)
    styleFamily "comparison"
