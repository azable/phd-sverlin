-- Illustrative body-only source for the target API in API_plan.md.
-- Unified typed steps, text trees, and Render-controlled frames are proposed APIs.

data Number

type instance Payload Number = LInt Number

data Condition

type instance Payload Condition = LBool Condition

data IndexCell

type instance Payload IndexCell = LUnit IndexCell

data LimitCell

type instance Payload LimitCell = LUnit LimitCell

data Add = Add

type instance Payload Add = LOperator Add Add

instance CoreOperator Add where
  operatorPayloadText Add = "+"
  persistOperatorPayload Add = Ur Add

instance Applicable2 Add Number Number where
  type Apply2Result Add Number Number = Number
  applyPayload2 (LOperator Add) = applyLinear2Into (Linear.+)

data LessThan = LessThan

type instance Payload LessThan = LOperator LessThan LessThan

instance CoreOperator LessThan where
  operatorPayloadText LessThan = "<"
  persistOperatorPayload LessThan = Ur LessThan

instance Applicable2 LessThan Number Number where
  type Apply2Result LessThan Number Number = Condition
  applyPayload2 (LOperator LessThan) = applyLinear2Into (Linear.<)

type CountTo = "count-to"
type BindLimit = "count-to/bind-limit"
type InitializeIndex = "count-to/initialize-index"
type TestLoopBound = "count-to/test-loop-bound"
type IncrementIndex = "count-to/increment-index"
type FinishProgram = "count-to/finish"

type CreateValue parent = parent / "create-value"
type CreateCell parent = parent / "create-cell"
type AssignValue parent = parent / "assign"
type CreateStoredChildren = '["create-value", "create-cell", "assign"]

type ReadIndexForBound = "count-to/test-loop-bound/read-index"
type ReadLimitForBound = "count-to/test-loop-bound/read-limit"
type CreateLessThanOperator = "count-to/test-loop-bound/create-operator"
type CompareIndexToLimit = "count-to/test-loop-bound/compare"

type ReadIndexForIncrement = "count-to/increment-index/read-index"
type CreateOne = "count-to/increment-index/create-one"
type CreateAddOperator = "count-to/increment-index/create-operator"
type AddOneToIndex = "count-to/increment-index/add"
type WriteIndex = "count-to/increment-index/write"

type DestroyIndexStorage = "count-to/finish/destroy-index"
type DestroyLimitStorage = "count-to/finish/destroy-limit"

domain :: Domain ()
domain = do
  declarePayload @Number
  declarePayload @Condition
  declarePayload @IndexCell
  declarePayload @LimitCell
  declareOperator Add
  declareOperator LessThan
  declareBranches @'[BindLimit, InitializeIndex] @CreateStoredChildren
  declareSteps
    @'[ CountTo
      , TestLoopBound
      , IncrementIndex
      , FinishProgram
      , ReadIndexForBound
      , ReadLimitForBound
      , CreateLessThanOperator
      , CompareIndexToLimit
      , ReadIndexForIncrement
      , CreateOne
      , CreateAddOperator
      , AddOneToIndex
      , WriteIndex
      , DestroyIndexStorage
      , DestroyLimitStorage
      ]

data Stored owner value where
  Stored :: Block owner %1 -> Slot owner value %1 -> Stored owner value

data ReadStored owner value where
  ReadStored :: Stored owner value %1 -> Block value %1 -> ReadStored owner value

data LoopTest where
  ContinueLoop :: Stored IndexCell Number %1 -> Stored LimitCell Number %1 -> LoopTest
  ExitLoop :: Stored IndexCell Number %1 -> Stored LimitCell Number %1 -> LoopTest

createStored ::
  forall parent owner value.
  (KnownSymbol parent, Traceable owner, Traceable value) =>
  Query ->
  Payload owner %1 ->
  Query ->
  Payload value %1 ->
  Program (Stored owner value)
createStored ownerFacts ownerPayload valueFacts valuePayload = step @parent $ do
  value <- step @(CreateValue parent) $ do
    Create pending <- create valuePayload
    materialize valueFacts pending

  cell <- step @(CreateCell parent) $ do
    Create pending <- create ownerPayload
    materialize ownerFacts pending

  step @(AssignValue parent) $ do
    Seal cell1 slot <- seal cell value
    return (Stored cell1 slot)

readStored :: (Traceable owner, Traceable value) => Query -> Stored owner value %1 -> Program (ReadStored owner value)
readStored query (Stored owner slot) = do
  Unseal owner1 value <- unseal owner slot
  Copy value1 copyPending <- copy value
  valueCopy <- materialize query copyPending
  Seal owner2 slot1 <- seal owner1 value1
  return (ReadStored (Stored owner2 slot1) valueCopy)

writeStored :: (Traceable owner, Traceable value) => Query -> Stored owner value %1 -> Pending value %1 -> Program (Stored owner value)
writeStored query (Stored owner slot) replacement = do
  Unseal owner1 oldValue <- unseal owner slot
  Replace storedPending <- replace oldValue replacement
  storedValue <- materialize query storedPending
  Seal owner2 slot1 <- seal owner1 storedValue
  return (Stored owner2 slot1)

destroyStored :: (Traceable owner, Traceable value) => Stored owner value %1 -> Program ()
destroyStored (Stored owner slot) = do
  Unseal owner1 value <- unseal owner slot
  Destroy <- destroy value
  Destroy <- destroy owner1
  return ()

bindLimit :: Int -> Program (Stored LimitCell Number)
bindLimit limitValue = createStored @BindLimit #limitCell LUnit #limit (LInt limitValue)

initializeIndex :: Program (Stored IndexCell Number)
initializeIndex = createStored @InitializeIndex #indexCell LUnit #index (LInt 0)

testLoopBound :: Stored IndexCell Number %1 -> Stored LimitCell Number %1 -> Program LoopTest
testLoopBound index limit = step @TestLoopBound $ do
  ReadStored index1 indexProbe <- step @ReadIndexForBound (readStored #indexRead index)
  ReadStored limit1 limitProbe <- step @ReadLimitForBound (readStored #limitRead limit)

  lessThan <- step @CreateLessThanOperator $ do
    Create pending <- create @LessThan (LOperator LessThan)
    materialize #lessThanOperator pending

  continue <- step @CompareIndexToLimit $ do
    Apply2 conditionPending <- apply2 lessThan indexProbe limitProbe
    condition <- materialize #loopCondition conditionPending
    Use result <- use condition
    case result of
      OneUse (LBool answer) -> return answer

  case continue of
    True -> return (ContinueLoop index1 limit1)
    False -> return (ExitLoop index1 limit1)

incrementIndex :: Stored IndexCell Number %1 -> Program (Stored IndexCell Number)
incrementIndex index = step @IncrementIndex $ do
  ReadStored index1 indexProbe <- step @ReadIndexForIncrement (readStored #indexRead index)

  one <- step @CreateOne $ do
    Create pending <- create @Number (LInt 1)
    materialize #increment pending

  add <- step @CreateAddOperator $ do
    Create pending <- create @Add (LOperator Add)
    materialize #addOperator pending

  nextPending <- step @AddOneToIndex $ do
    Apply2 pending <- apply2 add indexProbe one
    return pending

  step @WriteIndex (writeStored #index index1 nextPending)

finishProgram :: Stored IndexCell Number %1 -> Stored LimitCell Number %1 -> Program ()
finishProgram index limit = step @FinishProgram $ do
  step @DestroyIndexStorage (destroyStored index)
  step @DestroyLimitStorage (destroyStored limit)

countLoop :: Stored IndexCell Number %1 -> Stored LimitCell Number %1 -> Program ()
countLoop index limit = do
  result <- testLoopBound index limit
  case result of
    ContinueLoop index1 limit1 -> do
      index2 <- incrementIndex index1
      countLoop index2 limit1
    ExitLoop index1 limit1 -> finishProgram index1 limit1

program :: Program ()
program = step @CountTo $ do
  limit <- bindLimit 4
  index <- initializeIndex
  countLoop index limit

pseudocode :: TextTree
pseudocode =
  block @CountTo
    (do
      literal "count to "
      fragmentMany @'[BindLimit, CreateValue BindLimit, CreateCell BindLimit, AssignValue BindLimit] "limit"
      literal ":")
    $ do
      line @InitializeIndex $ do
        fragmentMany @'[CreateCell InitializeIndex, AssignValue InitializeIndex] "set counter to "
        fragment @(CreateValue InitializeIndex) "zero"

      block @TestLoopBound
        (do
          literal "while "
          fragment @ReadIndexForBound "counter"
          fragmentMany @'[CreateLessThanOperator, CompareIndexToLimit] " is below "
          fragment @ReadLimitForBound "limit"
          literal ":")
        $ do
          line @IncrementIndex $ do
            fragmentMany
              @'[ReadIndexForIncrement, CreateAddOperator, AddOneToIndex, WriteIndex]
              "increase counter by "
            fragment @CreateOne "one"

      line @FinishProgram $ fragmentMany @'[DestroyIndexStorage, DestroyLimitStorage] "finish"

cSource :: TextTree
cSource =
  delimitedBlock @CountTo
    (do
      literal "void count_to(int "
      fragmentMany @'[BindLimit, CreateValue BindLimit, CreateCell BindLimit, AssignValue BindLimit] "limit"
      literal ") {")
    (literal "}")
    $ do
      line @InitializeIndex $ do
        fragment @(CreateCell InitializeIndex) "int i"
        fragment @(AssignValue InitializeIndex) " = "
        fragment @(CreateValue InitializeIndex) "0"
        literal ";"

      delimitedBlock @TestLoopBound
        (do
          literal "while ("
          fragment @ReadIndexForBound "i"
          fragmentMany @'[CreateLessThanOperator, CompareIndexToLimit] " < "
          fragment @ReadLimitForBound "limit"
          literal ") {")
        (literal "}")
        $ do
          line @IncrementIndex $
            fragmentMany
              @'[ReadIndexForIncrement, CreateOne, CreateAddOperator, AddOneToIndex, WriteIndex]
              "i++;"

      line @FinishProgram $ do
        fragmentMany @'[DestroyIndexStorage, DestroyLimitStorage] "return"
        literal ";"

type PresentationFrames = '[BindLimit, InitializeIndex, TestLoopBound, IncrementIndex, FinishProgram]

render :: Render ()
render = do
  width (by 960)
  height (by 600)
  contentFit Both Contain
  framesAt @PresentationFrames

  source <- textNodes pseudocode

  node source $ do
    left (at 36)
    top (at 32)
    width (by 500)
    height (by 520)
    style @FontFamily (FixedStyle FontIBMPlexMono)
    style @WhiteSpace (FixedStyle WhiteSpacePre)

  Bound indexLabel <- bindContent
  Selected indices <- select @Number (#index <&> payload indexLabel)
  Bound limitLabel <- bindContent
  Selected limits <- select @Number (#limit <&> payload limitLabel)
  Bound indexReadLabel <- bindContent
  Selected indexReads <- select @Number (#indexRead <&> payload indexReadLabel)
  Bound limitReadLabel <- bindContent
  Selected limitReads <- select @Number (#limitRead <&> payload limitReadLabel)
  Bound conditionLabel <- bindContent
  Selected conditions <- select @Condition (#loopCondition <&> payload conditionLabel)

  node indices $ do
    fitText indexLabel
    left (at 620)
    top (at 120)
    width (by 120)
    height (by 88)
    styleFamily "index"

  node limits $ do
    fitText limitLabel
    left (at 790)
    top (at 120)
    width (by 120)
    height (by 88)
    styleFamily "limit"

  node indexReads $ do
    fitText indexReadLabel
    left (at 620)
    top (at 270)
    width (by 110)
    height (by 80)
    styleFamily "read"

  node limitReads $ do
    fitText limitReadLabel
    left (at 800)
    top (at 270)
    width (by 110)
    height (by 80)
    styleFamily "read"

  node conditions $ do
    fitText conditionLabel
    left (at 710)
    top (at 410)
    width (by 110)
    height (by 80)
    styleFamily "condition"

  during @TestLoopBound $ mappedFragments @TestLoopBound source $ do
    style @FontWeight (FixedStyle FontWeightBold)

  during @IncrementIndex $ mappedFragments @IncrementIndex source $ do
    style @FontWeight (FixedStyle FontWeightBold)
